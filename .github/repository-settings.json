{
  "repository": {
    "name": "personal-homepage",
    "description": "个人主页：学习知识库、作品展示、常用网站、音乐电台与留言。Astro 静态主站，GitHub Pages 发布。",
    "private": false,
    "default_branch": "main",
    "has_issues": true,
    "has_discussions": true,
    "has_wiki": false,
    "has_projects": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "delete_branch_on_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY"
  },
  "branchProtection": {
    "required_status_checks": {
      "strict": true,
      "checks": [
        { "context": "Repository checks", "app_id": 15368 },
        { "context": "Workflow syntax", "app_id": 15368 },
        { "context": "Astro build", "app_id": 15368 }
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": false,
      "required_approving_review_count": 0,
      "require_last_push_approval": false
    },
    "restrictions": null,
    "required_linear_history": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "required_conversation_resolution": true
  },
  "workflowPermissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "pages": {
    "build_type": "workflow"
  },
  "labels": [
    { "name": "bug", "color": "d73a4a", "description": "可复现的错误" },
    { "name": "enhancement", "color": "a2eeef", "description": "需求与功能变更" },
    { "name": "documentation", "color": "0075ca", "description": "规范与说明文档" },
    { "name": "area:design", "color": "d4c5f9", "description": "页面、体验、概念与视觉参数" },
    { "name": "area:technical", "color": "1d76db", "description": "架构、数据、运行时与服务" },
    { "name": "area:content", "color": "0e8a16", "description": "文章、笔记、资料与素材" },
    { "name": "area:ci", "color": "fbca04", "description": "仓库管理、校验与构建发布" }
  ]
}
