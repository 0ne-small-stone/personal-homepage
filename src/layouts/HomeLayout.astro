---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '../styles/home.css';
import PageTransitions from '../components/navigation/PageTransitions.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import { ClientRouter } from 'astro:transitions';
import PersistentAudio from '../components/music/PersistentAudio.astro';
import { homeChapters } from '../components/home/home-chapters';
interface Props { title?: string; description?: string; journey?: boolean; lang?: 'zh-CN' | 'en'; languageHref?: string; homeHref?: string; }
const { title = 'Little Stone Still Here', description = '小石的学习、作品、影像与音乐。留下的东西，仍在这里。', journey = false, lang = 'zh-CN', languageHref, homeHref } = Astro.props;
---
<!doctype html>
<html lang={lang} transition:animate="none">
  <head><ClientRouter /><PageTransitions /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#000000" /><link rel="icon" href="data:," /><title>{title === 'Little Stone Still Here' ? title : `${title} · Little Stone Still Here`}</title></head>
  <body class:list={['lssh-home', { 'has-journey': journey }]}>
    {journey && <script is:inline define:vars={{ chapterHashes: homeChapters.map(chapter => `#${chapter.id}`) }}>
      // Gate only a position restore, before the first body paint. No-JS stays native.
      try {
        const type = performance.getEntriesByType('navigation')[0]?.type;
        const returning = type === 'back_forward' || type === 'reload';
        if (chapterHashes.includes(location.hash) || (returning && (history.state?.lsshHome || sessionStorage.getItem('lssh.home.return')))) {
          document.body.dataset.homeRestoring = 'true';
          setTimeout(() => { delete document.body.dataset.homeRestoring; }, 8000);
        }
      } catch { /* Storage or navigation timing is optional. */ }
    </script>}
    <a class="home-skip" href="#main-content">{lang === 'en' ? 'Skip to content' : '跳到正文'}</a><HomeHeader journey={journey} lang={lang} languageHref={languageHref} homeHref={homeHref} />
    <main id="main-content" tabindex="-1"><slot /></main>
    {!journey && <footer class="home-page-footer"><span>LSSH</span></footer>}
    <PersistentAudio />
  </body>
</html>
