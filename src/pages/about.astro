---
import HomeLayout from '../layouts/HomeLayout.astro';
import portrait from '../assets/about/portrait.jpg';
import { profile } from '../data/profile';
import { sitePath } from '../lib/paths';
import '../styles/about.css';

const sections = [
  { id: 'experience', label: '一些经历' },
  { id: 'practice', label: '能力与协作' },
  { id: 'life', label: '生活的另一面' },
  { id: 'contact', label: '联系' },
];
---
<HomeLayout title="Someone" description="我是小石，张轩石。浙江大学软件工程学生，做软件、设计产品，也在音乐和志愿服务里留下日常。">
  <article class="someone-page">
    <section class="someone-hero" aria-labelledby="someone-title">
      <div class="someone-hero-copy">
        <p class="someone-page-label">关于我</p>
        <h1 id="someone-title">Someone</h1>
        <p class="someone-greeting">我是{profile.nickname}。</p>
        <p class="someone-identity">{profile.name}，{profile.university}{profile.major}学生。</p>
        <div class="someone-introduction">{profile.introduction.map(paragraph => <p>{paragraph}</p>)}</div>
        <a class="someone-button" href="#contact">聊一聊<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
      </div>
      <figure class="someone-portrait"><img src={portrait.src} width={portrait.width} height={portrait.height} alt={`${profile.name}的肖像`} loading="eager" decoding="async" /></figure>
    </section>
    <div class="someone-reading-layout">
      <aside class="someone-index">
        <nav aria-label="Someone 页内目录">{sections.map(section => <a href={`#${section.id}`}>{section.label}</a>)}</nav>
        <a class="someone-home-link" href={`${sitePath()}#intro`}>返回首页</a>
      </aside>
      <div class="someone-reading">
        <section id="experience" class="someone-section" aria-labelledby="experience-title">
          <h2 id="experience-title">一些经历</h2>
          <p class="someone-section-intro">从代码、产品到人与人之间的协作。</p>
          <ol class="someone-experiences">
            {profile.experiences.map(experience => <li id={`experience-${experience.id}`}>
              <p class="someone-period">{experience.period}</p>
              <div class="someone-experience-copy"><h3>{experience.title}</h3><p class="someone-role">{experience.role}</p>{experience.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
            </li>)}
          </ol>
        </section>
        <section id="practice" class="someone-section" aria-labelledby="practice-title">
          <h2 id="practice-title">能力与协作</h2>
          <div class="someone-capabilities">{profile.capabilities.map(capability => <div><h3>{capability.title}</h3><ul aria-label={`${capability.title}相关能力`}>{capability.items.map(item => <li>{item}</li>)}</ul><p>{capability.description}</p></div>)}</div>
          <div class="someone-learning"><h3>仍在学习</h3><p>{profile.learning}</p></div>
        </section>
        <section id="life" class="someone-section" aria-labelledby="life-title">
          <h2 id="life-title">生活的另一面</h2>
          {profile.life.map(paragraph => <p>{paragraph}</p>)}
          <div class="someone-traces"><h3>在这里，继续认识我</h3><ul>{profile.traces.map(trace => <li><a href={sitePath(trace.path)}><span class="someone-trace-name">{trace.name}</span><span class="someone-trace-label">{trace.label}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a></li>)}</ul></div>
        </section>
        <section id="contact" class="someone-section someone-contact" aria-labelledby="contact-title">
          <h2 id="contact-title">聊一聊</h2>
          <p>关于产品、设计、音乐，或者你在这里看到的东西。</p>
          <div class="someone-email-row"><a class="someone-email" href={`mailto:${profile.email}`}>{profile.email}</a><button class="someone-copy" type="button" data-copy-email={profile.email} hidden>复制邮箱</button></div>
          <p class="someone-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
          <a class="someone-wall-link" href={sitePath('guestbook')}>也可以去留言墙看看<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg></a>
        </section>
      </div>
    </div>
  </article>
</HomeLayout>

<script>
  let dispose = () => {};
  function initializeSomeone() {
    dispose();
    dispose = () => {};
    const page = document.querySelector<HTMLElement>('.someone-page');
    if (!page) return;
    const button = page.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = page.querySelector<HTMLElement>('.someone-copy-status');
    if (!button || !status || !navigator.clipboard?.writeText) return;
    const controller = new AbortController();
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    button.hidden = false;
    button.addEventListener('click', async () => {
      if (button.disabled) return;
      button.disabled = true;
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        if (controller.signal.aborted) return;
        button.textContent = '已复制';
        status.textContent = '邮箱已复制，可以粘贴到你的邮件应用中。';
      } catch {
        if (controller.signal.aborted) return;
        status.textContent = '复制未成功，可以直接选中邮箱复制，或点击邮箱发送邮件。';
      } finally {
        if (!controller.signal.aborted) {
          button.disabled = false;
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => { button.textContent = '复制邮箱'; }, 2000);
        }
      }
    }, { signal: controller.signal });
    dispose = () => { controller.abort(); clearTimeout(resetTimer); };
  }
  initializeSomeone();
  document.addEventListener('astro:page-load', initializeSomeone);
  document.addEventListener('astro:before-swap', () => dispose());
</script>
