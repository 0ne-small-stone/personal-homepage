---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import KnowledgeTypeFilter from '../../components/KnowledgeTypeFilter.astro';
import { publishedKnowledge } from '../../lib/knowledge';
import { sitePath } from '../../lib/paths';

const entries = await publishedKnowledge();
---

<StarlightPage frontmatter={{ title: 'Becoming', description: '学习总览：资料、文章与笔记，共用一个入口。', tableOfContents: false, prev: false, next: false }}>
  <KnowledgeTypeFilter entries={entries} />
  <div class="becoming-overview-footer">
    <a href={sitePath('knowledge/blog')}>按时间浏览文章</a>
  </div>
</StarlightPage>
