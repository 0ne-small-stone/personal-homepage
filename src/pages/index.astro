---
import '../styles/home-soundscape.css';
import '../styles/home-relief.css';
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeCta from '../components/home/HomeCta.astro';
import InviteMark from '../components/navigation/InviteMark.astro';
import HomeChapterMark from '../components/home/HomeChapterMark.astro';
import HomeReliefPalette from '../components/home/HomeReliefPalette.astro';
import HomeJourney from '../components/home/HomeJourney';
import { homeChapterNumerals } from '../lib/home-chapter-shapes';
import { homeChapters, homeWorkChapters } from '../components/home/home-chapters';
import { sitePath } from '../lib/paths';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { srcDir } from 'astro:config/server';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';
import wordmark from '../assets/home/lssh-wordmark.png';
const sources = import.meta.glob<ImageMetadata>('../assets/home/reliefs/*.png', { eager: true, import: 'default' });
async function relief(name: string, alt: string) {
  const path = `assets/home/reliefs/${name}.png`;
  const [image, preview] = await Promise.all([
    getImage({ src: sources[`../${path}`], width: 1600, format: 'webp', quality: 85 }),
    sharp(fileURLToPath(new URL(path, srcDir))).resize(224).webp({ quality: 60 }).toBuffer(),
  ]);
  return { image, preview: `data:image/webp;base64,${preview.toString('base64')}`, alt };
}
const markImage = await getImage({src:wordmark,width:768,format:'webp',quality:90});
const [album, radio, projects] = await Promise.all([
  relief('01-a-moment-remains-relief', '持相机的青年、门与交错的人群'),
  relief('02-echoes-relief', '各自聆听的人与递出的耳机'),
  relief('03-afterimage-relief', '折返的草稿、搭起的框架与共同创作的人'),
]);
const reliefs = { album, radio, projects };
---
<HomeLayout journey description="小石的学习、作品、影像与音乐。">
  <HomeReliefPalette />
  <HomeJourney client:only="react" wordmarkUrl={markImage.src} />
  <section id="intro" class="home-chapter home-hero" aria-labelledby="home-title" data-chapter="intro">
    <div class="home-chapter-viewport"><div class="home-chapter-content">
      <h1 id="home-title" class="sr-only">Little Stone Still Here</h1>
      <Image class="home-wordmark" src={wordmark} width={768} alt="Little Stone Still Here" loading="eager" fetchpriority="high" format="webp" quality={90} />
      <a class="home-scroll" href={`#${homeWorkChapters[0].id}`}><InviteMark direction="down" size={22} className="home-explore-invite" />向下探索</a>
    </div></div>
  </section>
  <section class="home-works-intro" aria-hidden="true"></section>
  <div class="home-works" data-work-count={homeWorkChapters.length}>
  {homeWorkChapters.map((chapter,index) => <section id={chapter.id} class:list={['home-chapter','home-work-chapter',`home-work-${chapter.id}`]} aria-labelledby={`title-${chapter.id}`} data-chapter={chapter.id} data-work-item={index}>
    <div class="home-chapter-viewport">
      <div class="home-chapter-content" data-lenis-prevent>
        <div class="home-work-copy">
          <h2 id={`title-${chapter.id}`}>{chapter.title}</h2>
          <p class="home-description">{chapter.description}</p>
        </div>
        <HomeCta href={sitePath(chapter.path)} label={chapter.action} id={`entry-${chapter.id}`} />
      </div>
      <figure class="home-art home-art--scene">
        <a class="home-relief-native" href={sitePath(chapter.path)} data-home-link data-relief-full={reliefs[chapter.id].image.src}>
          <picture>
            <source media="(scripting: enabled)" srcset={reliefs[chapter.id].preview} />
            <img class="home-project-cover" src={reliefs[chapter.id].image.src} width={reliefs[chapter.id].image.attributes.width} height={reliefs[chapter.id].image.attributes.height} alt={reliefs[chapter.id].alt} loading="lazy" />
          </picture>
        </a>
      </figure>
      <a class="home-relief-hit" data-relief-hit data-home-link href={sitePath(chapter.path)} tabindex="-1" aria-hidden="true"></a>
    </div>
  </section>)}
  </div>
  <div class="home-works-outro" aria-hidden="true"></div><div class="home-works-expand" aria-hidden="true"></div><div class="home-wall-reveal" aria-hidden="true"></div>
  <section id="wall" class="home-chapter home-wall" aria-labelledby="title-wall" data-chapter="wall">
    <div class="home-chapter-viewport"><div class="home-wall-surface" aria-hidden="true"></div><div class="home-chapter-content">
      <h2 id="title-wall">The Wall</h2><p class="home-description">走到这里，也留下你的回声。</p>
      <div class="home-wall-empty"><p>在砖墙上阅读彼此留下的话语，也可以通过 GitHub 留下自己的回声。</p></div>
      <HomeCta href={sitePath('guestbook')} label="查看留言区" id="entry-wall" />
      <div class="home-wall-bottom"><a href="#intro">回到序章</a><a href={sitePath('about')} id="wall-about" data-home-link>认识小石</a></div>
    </div></div>
  </section>
  <div class="home-scene-toolbar-slot" data-home-scene-toolbar></div>
  <nav class="home-chapter-index" aria-label="首页章节"><div class="home-chapter-reel">{homeChapters.map((chapter,index) => <a href={`#${chapter.id}`} draggable="false" aria-label={`${homeChapterNumerals[index]} · 转到${chapter.label}`}><HomeChapterMark index={index} /></a>)}</div></nav>
</HomeLayout>
<script>
  import { installHomeChapterFocus } from '../components/home/home-chapter-focus';
  import { installReliefLoading } from '../components/home/relief-loading';
  installHomeChapterFocus();
  let release = installReliefLoading();
  document.addEventListener('astro:before-swap', () => { release(); });
  document.addEventListener('astro:after-swap', () => { release = installReliefLoading(); });
</script>
