---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeCta from '../components/home/HomeCta.astro';
import HomeJourney from '../components/home/HomeJourney';
import Guestbook from '../components/home/Guestbook.astro';
import { homeChapters, selectedLinks } from '../components/home/home-chapters';
import { sitePath } from '../lib/paths';
import { Image, getImage } from 'astro:assets';
import wordmark from '../assets/home/lssh-wordmark.png';
import albumCover from '../assets/home/echoes-placeholder.jpg';
import projectCover from '../assets/home/the-wall-placeholder.jpg';
import neighborCover from '../assets/home/wish-neighbor-placeholder.png';
const markImage = await getImage({src:wordmark,width:768,format:'webp',quality:90});
const albumImage = await getImage({src:albumCover,width:1100,format:'webp',quality:85});
const projectImage = await getImage({src:projectCover,width:1100,format:'webp',quality:85});
const neighborImage = await getImage({src:neighborCover,width:1000,format:'webp',quality:85});
---
<HomeLayout journey description="小石的学习、作品、影像与音乐。">
  <HomeJourney client:only="react" wordmarkUrl={markImage.src} albumUrl={albumImage.src} projectUrl={projectImage.src} neighborUrl={neighborImage.src} />
  <section id="intro" class="home-chapter home-hero" aria-labelledby="home-title" data-chapter="intro">
    <div class="home-chapter-viewport"><div class="home-chapter-content">
      <h1 id="home-title" class="sr-only">Little Stone Still Here</h1>
      <Image class="home-wordmark" src={wordmark} width={768} alt="Little Stone Still Here" loading="eager" format="webp" quality={90} />
      <a class="home-scroll" href="#projects"><svg width="16" height="20" viewBox="0 0 16 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v14M3 11l5 5 5-5" /></svg>向下探索</a>
    </div></div>
  </section>
  <section class="home-works-intro" aria-hidden="true"></section>
  <div class="home-works" data-work-count="4">
  {homeChapters.slice(1,5).map((chapter,index) => 'path' in chapter && <section id={chapter.id} class:list={['home-chapter','home-work-chapter',`home-work-${chapter.id}`]} aria-labelledby={`title-${chapter.id}`} data-chapter={chapter.id} data-work-item={index}>
    <div class="home-chapter-viewport">
      <div class="home-chapter-content"><h2 id={`title-${chapter.id}`}>{chapter.title}</h2><p class="home-description">{chapter.description}</p><HomeCta href={sitePath(chapter.path)} label={chapter.action} id={`entry-${chapter.id}`} />
        {chapter.id === 'projects' && <p class="home-chapter-note">视觉占位 · Pink Floyd — The Wall</p>}
        {chapter.id === 'radio' && <p class="home-chapter-note">唱片图占位 · Wish You Were Here · 播放与共享歌单待接入</p>}
        {chapter.id === 'album' && <p class="home-chapter-note">影像占位 · Pink Floyd — Echoes</p>}
      </div>
      {chapter.id === 'projects' && <figure class="home-art home-art--scene"><img class="home-project-cover" src={projectImage.src} width={projectImage.attributes.width} height={projectImage.attributes.height} alt="视觉占位：Pink Floyd《The Wall》专辑封面，规整的白色砖墙" loading="lazy" /></figure>}
      {chapter.id === 'radio' && <figure class="home-art home-art--scene"><img class="home-project-cover" src={neighborImage.src} width={neighborImage.attributes.width} height={neighborImage.attributes.height} alt="唱片图占位：Pink Floyd《Wish You Were Here》黑胶唱片，保留透明外缘与中心孔" loading="lazy" /></figure>}
      {chapter.id === 'album' && <figure class="home-art home-art--scene"><img class="home-project-cover" src={albumImage.src} width={albumImage.attributes.width} height={albumImage.attributes.height} alt="影像占位：Pink Floyd《Echoes》精选集封面，完整保留嵌套窗口与摄影拼景" loading="lazy" /></figure>}
      {chapter.id === 'links' && <ul class="home-art home-links-preview">{selectedLinks.map(link => <li><a href={link.url} target="_blank" rel="noreferrer"><strong>{link.title}</strong><span>{link.detail}<span class="sr-only">（新窗口）</span></span></a></li>)}</ul>}
    </div>
  </section>)}
  </div>
  <div class="home-works-outro" aria-hidden="true"></div><div class="home-wall-reveal" aria-hidden="true"></div>
  <section id="wall" class="home-chapter home-wall" aria-labelledby="title-wall" data-chapter="wall">
    <div class="home-chapter-viewport"><div class="home-wall-surface" aria-hidden="true"></div><div class="home-chapter-content">
      <h2 id="title-wall">The Wall</h2><p class="home-description">走到这里，也留下你的回声。</p>
      <div class="home-wall-empty"><Guestbook /></div>
      <HomeCta href={sitePath('guestbook')} label="查看留言区" id="entry-wall" />
      <div class="home-wall-bottom"><a href="#intro">回到序章</a><a href={sitePath('about')}>认识小石</a></div>
    </div></div>
  </section>
  <nav class="home-chapter-index" aria-label="首页章节">{homeChapters.map((chapter,index) => <a href={`#${chapter.id}`} aria-label={`转到${chapter.label}`} aria-current={index === 0 ? 'location' : undefined}>{String(index).padStart(2,'0')}</a>)}</nav>
</HomeLayout>
