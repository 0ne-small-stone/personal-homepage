---
import { showcaseWorks, type ShowcaseWork } from '../../data/showcase';
import { showcaseIsOpen } from '../../data/showcase-availability.mjs';
import ShowcaseConstruction from '../../components/showcase/ShowcaseConstruction.astro';

export function getStaticPaths() {
  return showcaseWorks.map((work, index) => ({ params: { slug: work.slug }, props: { work, next: showcaseWorks[(index + 1) % showcaseWorks.length] } }));
}
interface Props { work: ShowcaseWork; next: ShowcaseWork; }
const Detail = showcaseIsOpen ? (await import('../../components/showcase/ShowcaseDetail.astro')).default : null;
---
{Detail ? <Detail {...Astro.props} /> : <ShowcaseConstruction />}
