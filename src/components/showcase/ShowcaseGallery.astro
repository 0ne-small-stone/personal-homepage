---
import { showcaseWorks, workKinds, workCover, workImageSize } from '../../data/showcase';
import { sitePath } from '../../lib/paths';
---
<afterimage-gallery class="afterimage" data-view="exhibition" data-page-path={sitePath('showcase')}>
  <header class="ai-intro">
    <div class="ai-heading"><h1>Afterimage<span class="ai-title-dot" aria-hidden="true">.</span></h1><p class="ai-intro-copy">项目、影像与文字</p></div>
  </header>
  <div class="ai-toolbar" aria-label="作品浏览选项">
    <div class="ai-filters" role="group" aria-label="按内容形式筛选">
      {workKinds.map(kind => <button type="button" data-filter={kind.id} aria-pressed={kind.id === 'all'}>{kind.label}<span>{kind.id === 'all' ? showcaseWorks.length : showcaseWorks.filter(work => work.kind === kind.id).length}</span></button>)}
    </div>
    <div class="ai-views" role="group" aria-label="浏览方式">
      <button type="button" data-view-button="exhibition" aria-pressed="true"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><rect x="6" y="4" width="8" height="12" rx="1"/><path d="M3 6H1v8h2m14-8h2v8h-2"/></svg>展览</button>
      <button type="button" data-view-button="index" aria-pressed="false"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M7 5h11M7 10h11M7 15h11M2 5h1m-1 5h1m-1 5h1"/></svg>目录</button>
    </div>
  </div>
  <p class="ai-sr" role="status" data-announcement></p>
  <div class="ai-rail" tabindex="0" role="region" aria-label="作品展览，可左右拖动或用方向键选择">
    {showcaseWorks.map((work, index) => <article class="ai-work" data-slug={work.slug} data-kind={work.kind} data-title={work.title} data-active={index === 0}>
      <a class="ai-work-link" draggable="false" href={sitePath(`projects/${work.slug}`)} aria-label={`${work.title}，${work.kind === 'video' ? '观看视频' : '了解项目'}`}>
        <div class="ai-cover" data-format={workImageSize(work).format} transition:name={`afterimage-cover-${work.slug}`}>
          <img src={workCover(work, import.meta.env.BASE_URL)} alt="" width={workImageSize(work).width} height={workImageSize(work).height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" draggable="false" />
          <span class="ai-cover-fallback" hidden>封面暂时无法显示<span>仍可进入观看与阅读</span></span>
          <span class="ai-cover-note">{work.kind === 'video' ? `B站 / ${work.video?.duration}` : '项目视觉示意'}</span>
          <span class="ai-enter" aria-hidden="true">{work.kind === 'video' ? <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="m9 5 11 7-11 7z"/></svg> : <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"><path d="M6 18 18 6M6 6h12v12"/></svg>}</span>
        </div>
        <div class="ai-work-info"><div><p class="ai-discipline">{work.discipline}</p><h2>{work.title}</h2><p class="ai-summary">{work.description}</p></div><span class="ai-work-state">{work.status}</span></div>
      </a>
    </article>)}
  </div>
  <div class="ai-empty" hidden><p class="ai-empty-title">文字，慢慢写。</p><p>独立文字与项目阐述还在整理。<br />也可以前往 Becoming 的博客栏目。</p><div class="ai-empty-actions"><button type="button" data-show-all>浏览全部作品</button><a href={sitePath('knowledge/blog')}>打开博客 <span aria-hidden="true">↗</span></a></div></div>
  <div class="ai-exhibition-footer">
    <span class="ai-browse-hint">拖动探索 · 点击中央作品进入</span>
    <div class="ai-stepper"><span data-position aria-hidden="true">01 / {String(showcaseWorks.length).padStart(2, '0')}</span><button type="button" data-step="-1" aria-label="上一件作品" disabled><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button><button type="button" data-step="1" aria-label="下一件作品"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button></div>
  </div>
  <div class="ai-endnote"><p>每一件作品，都有自己的观看方式。</p><div class="ai-end-links"><a href={sitePath('knowledge/blog')}>去读文字 <span aria-hidden="true">↗</span></a><a href={sitePath('zh/about')}>认识小石 <span aria-hidden="true">↗</span></a></div></div>
  <noscript><p class="ai-noscript">所有作品都可直接打开；筛选与视图切换需要启用 JavaScript。</p></noscript>
</afterimage-gallery>

<script>
  import './showcase-gallery';
</script>
<style>
  @media (max-width: 600px) {
    .ai-intro { flex-wrap: wrap; row-gap: 12px; }
    .ai-intro :global(.db-return) { flex-shrink: 0; white-space: nowrap; }
  }
</style>
