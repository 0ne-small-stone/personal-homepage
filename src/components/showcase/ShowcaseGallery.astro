---
import InviteMark from '../navigation/InviteMark.astro';
import { showcaseWorks, publishedWorkFilters, workCover, workImageSize } from '../../data/showcase';
import { sitePath } from '../../lib/paths';
const filters = publishedWorkFilters(showcaseWorks);
const formats = filters.filter(kind => kind.id !== 'all').map(kind => kind.id === 'video' ? '影像' : kind.label);
const subtitle = new Intl.ListFormat('zh-CN').format(formats);
const workActions = { project: '了解项目', video: '观看视频', writing: '阅读作品' };
---
<afterimage-gallery class="afterimage" data-view="exhibition" data-page-path={sitePath('showcase')}>
  <header class="ai-intro">
    <div class="ai-heading"><h1>Afterimage<span class="ai-title-dot" aria-hidden="true">.</span></h1>{subtitle && <p class="ai-intro-copy">{subtitle}</p>}</div>
  </header>
  <div class="ai-toolbar" aria-label="作品浏览选项">
    <div class="ai-filters" role="group" aria-label="按内容形式筛选">
      {filters.map(kind => <button type="button" data-filter={kind.id} aria-pressed={kind.id === 'all'}>{kind.label}<span>{kind.count}</span></button>)}
    </div>
    <div class="ai-views" role="group" aria-label="浏览方式">
      <button type="button" data-view-button="exhibition" aria-pressed="true"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><rect x="6" y="4" width="8" height="12" rx="1"/><path d="M3 6H1v8h2m14-8h2v8h-2"/></svg>展览</button>
      <button type="button" data-view-button="index" aria-pressed="false"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M7 5h11M7 10h11M7 15h11M2 5h1m-1 5h1m-1 5h1"/></svg>目录</button>
    </div>
  </div>
  <p class="ai-sr" role="status" data-announcement></p>
  <div class="ai-rail" hidden={!showcaseWorks.length} tabindex="0" role="region" aria-label="作品展览，可左右拖动或用方向键选择">
    {showcaseWorks.map((work, index) => <article class="ai-work" data-slug={work.slug} data-kind={work.kind} data-title={work.title} data-action={workActions[work.kind]} data-active={index === 0}>
      <a class="ai-work-link" draggable="false" href={sitePath(`projects/${work.slug}`)} aria-label={`${work.title}，${workActions[work.kind]}`}>
        <div class="ai-cover" data-format={workImageSize(work).format} transition:name={`afterimage-cover-${work.slug}`}>
          <img src={workCover(work, import.meta.env.BASE_URL)} alt="" width={workImageSize(work).width} height={workImageSize(work).height} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" referrerpolicy="no-referrer" draggable="false" />
          <span class="ai-cover-fallback" hidden>封面暂时无法显示<span>仍可进入观看与阅读</span></span>
          <span class="ai-cover-note">{work.kind === 'video' ? `B站 / ${work.video?.duration}` : work.kind === 'writing' ? '文字作品' : '项目视觉示意'}</span>
          <span class="ai-enter" aria-hidden="true">{work.kind === 'video' ? <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="m9 5 11 7-11 7z"/></svg> : <InviteMark direction="diagonal" size={24} />}</span>
        </div>
        <div class="ai-work-info"><div><p class="ai-discipline">{work.discipline}</p><h2>{work.title}</h2><p class="ai-summary">{work.description}</p></div><span class="ai-work-state">{work.status}</span></div>
      </a>
    </article>)}
  </div>
  {!showcaseWorks.length && <p class="ai-empty">暂时没有公开作品。</p>}
  <div class="ai-exhibition-footer" hidden={!showcaseWorks.length}>
    <span class="ai-browse-hint">拖动探索 · 点击中央作品进入</span>
    <div class="ai-stepper"><span data-position aria-hidden="true">01 / {String(showcaseWorks.length).padStart(2, '0')}</span><button type="button" data-step="-1" aria-label="上一件作品" disabled><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button><button type="button" data-step="1" aria-label="下一件作品"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button></div>
  </div>
  <div class="ai-endnote"><p>每一件作品，都有自己的观看方式。</p><div class="ai-end-links"><a href={sitePath('knowledge/notes/computer-systems/computer-system-review')}>读 RandomStar 的计算机系统复习笔记 <InviteMark direction="diagonal" /></a><a href={sitePath('zh/about')}>认识小石 <InviteMark direction="diagonal" /></a></div></div>
  <noscript><p class="ai-noscript">所有作品都可直接打开；筛选与视图切换需要启用 JavaScript。</p></noscript>
</afterimage-gallery>

<script>
  import './showcase-gallery';
</script>
<style>
  @media (max-width: 600px) {
    .ai-intro { flex-wrap: wrap; row-gap: 12px; }
    .ai-intro :global(.db-return) { flex-shrink: 0; white-space: nowrap; }
  }
</style>
