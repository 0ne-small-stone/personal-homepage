---
import HomeLayout from '../../layouts/HomeLayout.astro';
import ShareCardHead from '../ShareCardHead.astro';
import InviteMark from '../navigation/InviteMark.astro';
import ContactIcon from './ContactIcon.astro';
import ProfileEntries from './ProfileEntries.astro';
import { profiles, type SomeoneLanguage } from '../../data/profile';
import { sitePath } from '../../lib/paths';
import '../../styles/about.css';

interface Props { lang?: SomeoneLanguage; }
const { lang = 'en' } = Astro.props;
const profile = profiles[lang];
const copy = lang === 'en' ? {
  description: `${profile.name} (Little Stone) studies software engineering at Zhejiang University and is a serial entrepreneur and musician focused on AI hardware products and interaction.`,
  shareDescription: `I study software engineering at ${profile.university}, work on AI hardware and make music.`,
  about: 'About me', greeting: `I'm ${profile.nickname}.`, identity: `${profile.name} · ${profile.major}, ${profile.university}`,
  talk: "Let's talk", index: 'On this page', home: 'Back home', experience: 'Ventures & projects', experienceIntro: 'Building products, making games and working with teams.',
  education: 'Education', campus: 'On campus', service: 'Community & volunteering', awards: 'Awards',
  campusIntro: 'Student organizations, class communities and the work behind the scenes.',
  serviceIntro: 'Elder care, class-based volunteering and learning through social practice.',
  campusDetails: 'More campus roles', serviceDetails: 'Projects & social practice',
  practice: 'What I do', skills: 'skills', learning: 'Still learning', life: 'Beyond the screen', traces: 'More of me, here', contact: 'Contact',
  contactIntro: 'About products, design, music or something you found here.', copied: 'Email copied',
  copySuccess: 'Email copied. You can paste it into your mail app.', copyFailure: `Could not copy. You can select this address to copy it: ${profile.email}`,
  githubLabel: 'GitHub profile (opens in a new tab)', emailLabel: `Copy email address: ${profile.email}`, contactLinks: 'Contact links',
  wall: 'Leave a note on The Wall', deskCase: 'Read the Flow Desk case study (in Chinese)',
} : {
  description: `${profile.name}（小石），浙江大学软件工程在读，连续创业者、音乐人，关注 AI 硬件的产品形态与交互创新。`,
  shareDescription: `我在${profile.university}读${profile.major}，做 AI 硬件，也做音乐。`,
  about: '关于我', greeting: `我是${profile.nickname}。`, identity: `${profile.name}，${profile.university}${profile.major}学生。`,
  talk: '聊一聊', index: 'Someone 页内目录', home: '返回首页', experience: '创业与项目', experienceIntro: '做产品、做游戏，也和伙伴一起让想法落地。',
  education: '教育背景', campus: '校园里的我', service: '志愿与实践', awards: '获奖记录',
  campusIntro: '在学生组织与班级里，参与日常运营、活动组织和团队建设。',
  serviceIntro: '从社区助老到班级公益，在实践里认识人与人之间的联结。',
  campusDetails: '更多校园任职', serviceDetails: '项目与社会实践',
  practice: '能力与协作', skills: '相关能力', learning: '仍在学习', life: '生活的另一面', traces: '在这里，继续认识我', contact: '联系',
  contactIntro: '关于产品、设计、音乐，或者你在这里看到的东西。', copied: '邮箱已复制',
  copySuccess: '邮箱已复制，可以粘贴到你的邮件应用中。', copyFailure: `复制未成功，请选中这个地址复制：${profile.email}`,
  githubLabel: 'GitHub 主页（在新标签页打开）', emailLabel: `复制邮箱地址：${profile.email}`, contactLinks: '联系方式',
  wall: '也可以去留言墙看看', deskCase: '阅读随控 Desk 项目案例',
};

const deskCase = {
  label: copy.deskCase,
  href: sitePath('projects/suikong-desk') + (lang === 'en' ? '?from=someone-en' : ''),
};
const groups = [
  { id: 'experience', category: 'work', label: copy.experience, introduction: copy.experienceIntro },
  { id: 'campus', category: 'campus', label: copy.campus, introduction: copy.campusIntro, disclosure: copy.campusDetails },
  { id: 'service', category: 'service', label: copy.service, introduction: copy.serviceIntro, disclosure: copy.serviceDetails },
  { id: 'awards', category: 'awards', label: copy.awards },
].map(group => ({ ...group, entries: profile.experiences.filter(entry => entry.category === group.category) }))
  .filter(group => group.entries.length);
const sections = [
  ...(profile.education.length ? [{ id: 'education', label: copy.education }] : []),
  ...groups,
  { id: 'practice', label: copy.practice },
  { id: 'life', label: copy.life },
  { id: 'contact', label: copy.contact },
];
---
<HomeLayout title="Someone" lang={lang} description={copy.description} homeIconOnly>
  <ShareCardHead slot="head" page={lang === 'en' ? 'about' : 'zh/about'} lang={lang} type="profile"
    title={lang === 'en' ? `${profile.nickname} (${profile.name}) · Someone` : `${profile.nickname}（${profile.name}） · Someone`}
    author={profile.name} description={copy.shareDescription} image={lang === 'en' ? 'someone-en.png' : 'someone-zh.png'}
    imageAlt={lang === 'en'
      ? `Two faces in profile above “${profile.nickname}” and “${profile.name} · ${profile.university}”.`
      : `两张侧脸相向的线稿，下方写着「${profile.nickname}」和「${profile.name} · ${profile.university}」。`} />
  <div class="someone-language-tools">
    <a data-language-switch href={sitePath(lang === 'en' ? 'zh/about' : 'about')} hreflang={lang === 'en' ? 'zh-CN' : 'en'} lang={lang === 'en' ? 'zh-CN' : 'en'}>{lang === 'en' ? '中文' : 'English'}</a>
  </div>
  <article class="someone-page" data-copy-label={copy.emailLabel} data-copied={copy.copied} data-copy-success={copy.copySuccess} data-copy-failure={copy.copyFailure}>
    <section id="intro" class="someone-hero" aria-labelledby="someone-title" data-reading-block>
      <div class="someone-hero-copy">
        <p class="someone-page-label">{copy.about}</p>
        <h1 id="someone-title" class="someone-greeting">{copy.greeting}</h1>
        <p class="someone-identity">{copy.identity}</p>
        <div class="someone-introduction">{profile.introduction.map(paragraph => <p>{paragraph}</p>)}</div>
        <a class="someone-button" href="#contact">{copy.talk}<InviteMark /></a>
      </div>
    </section>
    <div class="someone-reading-layout">
      <aside class="someone-index">
        <nav aria-label={copy.index}>{sections.map(section => <a href={`#${section.id}`}>{section.label}</a>)}</nav>
      </aside>
      <div class="someone-reading">
        {profile.education.length > 0 && <section id="education" class="someone-section" aria-labelledby="education-title" data-reading-block>
          <h2 id="education-title">{copy.education}</h2>
          <ProfileEntries entries={profile.education} prefix="education" />
        </section>}
        {groups.map(group => {
          const primary = group.entries.filter(entry => !entry.detail);
          const more = group.entries.filter(entry => entry.detail);
          return <section id={group.id} class="someone-section" aria-labelledby={`${group.id}-title`} data-reading-block>
            <h2 id={`${group.id}-title`}>{group.label}</h2>
            {group.introduction && <p class="someone-section-intro">{group.introduction}</p>}
            {primary.length > 0 && <ProfileEntries entries={primary} deskCase={deskCase} />}
            {more.length > 0 && <details class="someone-details" id={`${group.id}-details`}>
              <summary><span>{group.disclosure ?? group.label}</span><span class="someone-details-count">{more.length}</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
              <ProfileEntries entries={more} deskCase={deskCase} />
            </details>}
          </section>;
        })}
        <section id="practice" class="someone-section" aria-labelledby="practice-title" data-reading-block>
          <h2 id="practice-title">{copy.practice}</h2>
          <div class="someone-capabilities">{profile.capabilities.map(capability => <div><h3>{capability.title}</h3><ul aria-label={`${capability.title} ${copy.skills}`}>{capability.items.map(item => <li>{item}</li>)}</ul>{capability.description && <p>{capability.description}</p>}</div>)}</div>
          <div class="someone-learning"><h3>{copy.learning}</h3><p>{profile.learning}</p></div>
        </section>
        <section id="life" class="someone-section" aria-labelledby="life-title" data-reading-block>
          <h2 id="life-title">{copy.life}</h2>
          {profile.life.map(paragraph => <p>{paragraph}</p>)}
          <div class="someone-traces"><h3>{copy.traces}</h3><ul>{profile.traces.map(trace => <li><a href={sitePath(trace.path)}><span class="someone-trace-name">{trace.name}</span><span class="someone-trace-label">{trace.label}</span><InviteMark /></a></li>)}</ul></div>
        </section>
        <section id="contact" class="someone-section someone-contact" aria-labelledby="contact-title" data-reading-block>
          <h2 id="contact-title">{copy.talk}</h2>
          <p>{copy.contactIntro}</p>
          <div class="someone-contact-links" role="group" aria-label={copy.contactLinks}>
            <a class="someone-contact-icon" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label={copy.githubLabel} title={copy.githubLabel}><ContactIcon name="github" /></a>
            <button class="someone-contact-icon" type="button" data-copy-email={profile.email} aria-label={copy.emailLabel} title={copy.emailLabel} disabled><ContactIcon name="email" /></button>
          </div>
          <noscript><p class="someone-copy-fallback">{lang === 'en' ? 'Copy this address manually:' : '可手动复制邮箱：'} {profile.email}</p></noscript>
          <p class="someone-copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
          <a class="someone-wall-link" href={sitePath('guestbook')}>{copy.wall}<InviteMark /></a>
        </section>
      </div>
    </div>
  </article>
</HomeLayout>

<script>
  import { setupSomeoneLanguage } from '../../lib/someone-language';
  let dispose = () => {};
  function initializeSomeone() {
    dispose();
    dispose = () => {};
    const page = document.querySelector<HTMLElement>('.someone-page');
    if (!page) return;
    const controller = new AbortController();
    function revealReadingTarget() {
      let id: string;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !page?.contains(target)) return;
      const disclosure = target.closest('details');
      if (disclosure && !disclosure.open) {
        disclosure.open = true;
        target.scrollIntoView({ block: 'start', behavior: 'instant' });
      }
    }
    revealReadingTarget();
    window.addEventListener('hashchange', revealReadingTarget, { signal: controller.signal });
    const disposeLanguage = setupSomeoneLanguage(page, controller.signal);
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    dispose = () => { controller.abort(); clearTimeout(resetTimer); disposeLanguage(); };
    const button = page.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = page.querySelector<HTMLElement>('.someone-copy-status');
    if (!button || !status) return;
    button.disabled = false;
    button.addEventListener('click', async () => {
      if (button.disabled) return;
      button.disabled = true;
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        if (controller.signal.aborted) return;
        button.setAttribute('aria-label', page.dataset.copied ?? '');
        button.title = page.dataset.copied ?? '';
        status.textContent = page.dataset.copySuccess ?? '';
      } catch {
        if (controller.signal.aborted) return;
        status.textContent = page.dataset.copyFailure ?? '';
      } finally {
        if (!controller.signal.aborted) {
          button.disabled = false;
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            button.setAttribute('aria-label', page.dataset.copyLabel ?? '');
            button.title = page.dataset.copyLabel ?? '';
          }, 2000);
        }
      }
    }, { signal: controller.signal });
  }
  initializeSomeone();
  document.addEventListener('astro:page-load', initializeSomeone);
  document.addEventListener('astro:before-swap', () => dispose());
</script>
