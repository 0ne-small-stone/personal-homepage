---
import InviteMark from '../navigation/InviteMark.astro';
import type { ProfileExperience } from '../../data/profile';

interface Props {
  entries: ProfileExperience[];
  deskCase?: { label: string; href: string };
  prefix?: 'experience' | 'education';
}
const { entries, prefix = 'experience', deskCase } = Astro.props;
---
<ol class="someone-experiences">
  {entries.map(entry => <li id={`${prefix}-${entry.id}`} data-reading-block>
    {entry.aliases.map(alias => <span id={`${prefix}-${alias}`} class="someone-anchor" aria-hidden="true"></span>)}
    <p class="someone-period">{entry.period}</p>
    <div class="someone-experience-copy">
      <h3>{entry.title}</h3>
      <p class="someone-role">{entry.role}</p>
      {entry.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      {deskCase && (entry.id === 'suikong' || entry.aliases.includes('suikong')) &&
        <a class="someone-wall-link" href={deskCase.href}>{deskCase.label}<InviteMark /></a>}
    </div>
  </li>)}
</ol>
