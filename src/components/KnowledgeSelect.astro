<knowledge-select><slot /></knowledge-select>

<script>
  /** Select-only combobox enhancement; the native select owns values and change events. */
  class KnowledgeSelect extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      if (this.controller && !this.controller.signal.aborted) return;
      const select = this.querySelector('select');
      if (!select) return;
      this.controller = new AbortController();
      const { signal } = this.controller;
      const owner = this.closest('knowledge-type-filter');
      const label = select.labels?.[0];
      const labelId = label?.id;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'knowledge-select-trigger';
      button.id = `${select.id}-trigger`;
      button.setAttribute('role', 'combobox');
      button.setAttribute('aria-haspopup', 'listbox');
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-controls', `${select.id}-listbox`);
      if (labelId) button.setAttribute('aria-labelledby', labelId);
      if (label) {
        const caption = document.createElement('span');
        caption.className = 'knowledge-select-label';
        caption.textContent = label.textContent;
        caption.setAttribute('aria-hidden', 'true');
        button.append(caption);
      }
      const value = document.createElement('span');
      value.className = 'knowledge-select-value';
      button.append(value);
      const chevron = document.createElement('span');
      chevron.className = 'knowledge-select-chevron';
      chevron.setAttribute('aria-hidden', 'true');
      button.append(chevron);
      const list = document.createElement('div');
      list.id = `${select.id}-listbox`;
      list.className = 'knowledge-select-menu';
      list.setAttribute('role', 'listbox');
      if (labelId) list.setAttribute('aria-labelledby', labelId);
      list.hidden = true;
      const options = [...select.options].map((option, index) => {
        const row = document.createElement('div');
        row.id = `${select.id}-option-${index}`;
        row.className = 'knowledge-select-option';
        row.setAttribute('role', 'option');
        row.textContent = option.textContent;
        list.append(row);
        return row;
      });
      this.append(button, list);
      select.hidden = true;
      if (label) label.htmlFor = button.id;
      let active = 0;
      let typed = '';
      let typedAt = 0;
      const sync = () => {
        value.textContent = select.selectedOptions[0]?.textContent ?? '';
        button.title = value.textContent;
        options.forEach((option, index) => option.setAttribute('aria-selected', String(index === select.selectedIndex)));
      };
      const close = () => {
        list.hidden = true;
        button.setAttribute('aria-expanded', 'false');
        button.removeAttribute('aria-activedescendant');
        typed = '';
      };
      const highlight = (index: number) => {
        active = Math.max(0, Math.min(options.length - 1, index));
        options.forEach((option, i) => option.toggleAttribute('data-active', i === active));
        button.setAttribute('aria-activedescendant', options[active].id);
        options[active].scrollIntoView({ block: 'nearest' });
      };
      const open = () => {
        sync();
        const bounds = button.getBoundingClientRect();
        const below = window.innerHeight - bounds.bottom - 24;
        const above = bounds.top - 24;
        const upwards = below < 180 && above > below;
        this.toggleAttribute('data-above', upwards);
        this.style.setProperty('--knowledge-menu-limit', `${Math.max(88, upwards ? above : below)}px`);
        list.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        highlight(select.selectedIndex);
      };
      const commit = (index: number) => {
        select.selectedIndex = index;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        sync();
        close();
        button.focus({ preventScroll: true });
      };
      button.addEventListener('click', () => list.hidden ? open() : close(), { signal });
      button.addEventListener('keydown', (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.isComposing) return;
        if (event.key === 'Tab') { close(); return; }
        if (event.key === 'Escape') {
          if (!list.hidden) { event.preventDefault(); event.stopPropagation(); close(); }
          return;
        }
        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          event.preventDefault();
          const wasClosed = list.hidden;
          if (wasClosed) open();
          if (event.key === 'Home') highlight(0);
          else if (event.key === 'End') highlight(options.length - 1);
          else if (!wasClosed) highlight(active + (event.key === 'ArrowDown' ? 1 : -1));
          return;
        }
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (list.hidden) open(); else commit(active);
          return;
        }
        if (event.key.length === 1) {
          const now = Date.now();
          typed = now - typedAt > 700 ? event.key : typed + event.key;
          typedAt = now;
          if (list.hidden) open();
          const match = options.findIndex((option) => option.textContent?.toLocaleLowerCase().startsWith(typed.toLocaleLowerCase()));
          if (match !== -1) highlight(match);
        }
      }, { signal });
      options.forEach((option, index) => {
        option.addEventListener('pointermove', () => {
          if (active !== index) {
            active = index;
            options.forEach((row, i) => row.toggleAttribute('data-active', i === active));
            button.setAttribute('aria-activedescendant', option.id);
          }
        }, { signal });
        option.addEventListener('pointerdown', (event) => event.preventDefault(), { signal });
        option.addEventListener('click', () => commit(index), { signal });
      });
      document.addEventListener('pointerdown', (event) => {
        if (!this.contains(event.target as Node)) close();
      }, { signal });
      window.addEventListener('resize', close, { signal });
      owner?.addEventListener('knowledge-filter-update', () => { sync(); close(); }, { signal });
      select.addEventListener('change', sync, { signal });
      sync();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.querySelectorAll('.knowledge-select-trigger,.knowledge-select-menu').forEach((element) => element.remove());
      const select = this.querySelector('select');
      if (select) {
        select.hidden = false;
        const label = document.getElementById(`${select.id}-label`);
        if (label instanceof HTMLLabelElement) label.htmlFor = select.id;
      }
    }
  }

  if (!customElements.get('knowledge-select')) customElements.define('knowledge-select', KnowledgeSelect);
</script>
