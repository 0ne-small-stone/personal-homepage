  index: { path: 'M6 3h11a2 2 0 0 1 2 2v16H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm0 0v14m0 0h13M3 18a3 3 0 0 1 3-1m4-10h5m-5 4h5m4-5h2m-2 5h2' },
