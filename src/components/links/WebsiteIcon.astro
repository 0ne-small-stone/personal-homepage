  compass: {
    path: 'm15.8 8.2-2.2 5.4-5.4 2.2 2.2-5.4 5.4-2.2Z',
    circles: [[12, 12, 9]],
  },
  lecture: { path: 'M5 4h14a2 2 0 0 1 2 2v11H3V6a2 2 0 0 1 2-2Zm3 16h8m-4-3v3M10 7.5v6l5-3-5-3Z' },
