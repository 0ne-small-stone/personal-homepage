const icon = icons[name];
---
<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={icon.path} />
  {icon.circles?.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
</svg>
