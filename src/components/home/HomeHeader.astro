---
import { homeControlStrokes, homeControlGesture } from '../../lib/home-control-shapes';
import { sitePath } from '../../lib/paths';
import ReturnLink from '../navigation/DivisionBellReturn.astro';
interface Props { journey?: boolean; lang?: 'zh-CN' | 'en'; homeHref?: string; }
const { journey = false, lang = 'zh-CN', homeHref } = Astro.props;
const pagePath = Astro.url.pathname;
const homeTarget = homeHref ?? `${sitePath()}#${pagePath.includes('/music') ? 'radio' : /\/(showcase|projects)(\/|$)/.test(pagePath) ? 'projects' : 'intro'}`;
const links = [{ name: 'Becoming', cn: '学习', en: 'Learning', path: 'knowledge' }, { name: 'Elsewhere', cn: '常用网站', en: 'Websites', path: 'links' }, { name: 'Someone', cn: '关于小石', en: 'About Little Stone', path: 'about' }];
const isCurrent = (path: string) => pagePath.startsWith(sitePath(path)) || (path === 'about' && pagePath.startsWith(sitePath('zh/about')));
const primary = journey || links.some(link => isCurrent(link.path));
---
<header class:list={['home-header', { 'is-primary': primary }]} data-journey={journey || undefined}>
  <ReturnLink class="home-brand" href={homeTarget} label={lang === 'en' ? 'Home' : '首页'} compact iconOnly />
  <nav aria-label={lang === 'en' ? 'Main navigation' : '主要导航'}>
    {links.map(({ name, cn, en, path }) => <a id={`nav-${path}`} href={sitePath(path === 'about' && pagePath.startsWith(sitePath('zh/about')) ? 'zh/about' : path)} data-home-link aria-current={isCurrent(path) ? 'page' : undefined} aria-label={`${name} · ${lang === 'en' ? en : cn}`}>
      {primary ? <span class="home-nav-label" aria-hidden="true"><span class="home-nav-reserve">{name}</span><span data-scramble={name}>{name}</span></span> : <span aria-hidden="true">{name}</span>}
    </a>)}
  </nav>
  <div class="home-header-actions">
    <a class="home-header-wall" href={`${sitePath()}#wall`} aria-label={lang === 'en' ? 'Go to The Wall' : '去留言墙'}>
      {primary ? <span class="home-control-mark" data-home-control-mark data-invite-gesture={homeControlGesture('wall',false)} aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          {homeControlStrokes('wall',false).map(({part,arrow,person}) => <path data-invite-part={part} data-invite-arrow={arrow} data-invite-person={person} d={arrow} />)}
        </svg>
      </span> : <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z" /></svg>}
      <span class="home-header-wall-label">The Wall</span>
    </a>
    {!primary && <span class="home-header-aux" aria-hidden="true" />}
  </div>
</header>

<script>
  import { installHomeControls } from './home-controls';
  import { mountInviteMarks } from '../../lib/invite-motion';

  let mounted: HTMLElement | null = null;
  let cleanup: (() => void) | undefined;
  function mount() {
    const header = document.querySelector<HTMLElement>('.home-header.is-primary');
    if (!header || header === mounted) return;
    mounted = header;
    const wall = mountInviteMarks(header, window, '[data-home-control-mark]');
    // The journey already owns its navigation labels and pause preferences.
    const labels = header.hasAttribute('data-journey') ? undefined : installHomeControls(header);
    cleanup = () => { labels?.(); wall(); };
  }
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; mounted = null; });
</script>

<style>
  :global(:root) { --home-header-height: calc(80px + env(safe-area-inset-top,0px)); }
  .home-header {
    position: fixed; inset: 0 0 auto; z-index: 20;
    display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
    align-items: center; gap: 24px; box-sizing: border-box;
    height: var(--home-header-height);
    padding: calc(16px + env(safe-area-inset-top,0px)) max(24px,calc((100% - 1200px)/2)) 16px;
    background: #000; color: #ededed; border-bottom: 1px solid #242424;
  }
  .home-header a { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; color: inherit; text-decoration: none; white-space: nowrap; touch-action: manipulation; }
  .home-header :global(.home-brand.db-return) { justify-self: start; min-width: 48px; min-height: 48px; height: 48px; padding: 4px; }
  .home-header :global(.home-brand .db-return-glyph-slot) { width: 36px; flex-basis: 36px; }
  nav { display: flex; justify-content: center; gap: 16px; min-width: 0; }
  nav a { position: relative; padding-inline: 8px; font: 400 14px/1.5 'IBM Plex Mono',ui-monospace,monospace; letter-spacing: .04em; }
  nav a::after { content: ''; position: absolute; inset: auto 8px 4px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: center; transition: transform 160ms ease; }
  nav a:active { background: #242424; }
  .home-header-actions { display: grid; grid-template-columns: auto 44px; align-items: center; justify-self: end; gap: 8px; }
  .home-header-wall { gap: 8px; padding: 0 16px; border: 1px solid #777; border-radius: 999px; font: 400 12px/1.5 'IBM Plex Mono',ui-monospace,monospace; letter-spacing: 0; }
  .home-header-wall svg { flex: none; }
  .home-header-aux { width: 44px; height: 44px; }
  .home-header :is(a:focus-visible, :global(.home-brand:focus-visible)) { outline: 2px solid currentColor; outline-offset: 3px; }
  @media (hover:hover) {
    nav a:hover::after { transform: scaleX(1); }
    .home-header-wall:hover { background: #ededed; color: #000; }
  }
  @media (max-width:49.999rem) {
    :global(:root) { --home-header-height: calc(112px + env(safe-area-inset-top,0px)); }
    .home-header { padding: calc(8px + env(safe-area-inset-top,0px)) 16px 8px; grid-template-columns: 48px minmax(0,1fr); grid-template-rows: 48px 44px; gap: 4px 16px; }
    nav { grid-column: 1 / -1; grid-row: 2; gap: 16px; }
    nav a { font-size: 13px; letter-spacing: .02em; }
    .home-header-actions { grid-column: 2; grid-row: 1; }
  }

  .home-header.is-primary {
    --header-edge: clamp(16px, 2.5vw, 40px);
    padding-left: max(var(--header-edge), env(safe-area-inset-left,0px));
    padding-right: max(var(--header-edge), env(safe-area-inset-right,0px));
  }
  .is-primary .home-header-actions { display: flex; }
  .is-primary .home-nav-label { position: relative; display: block; white-space: nowrap; }
  .is-primary .home-nav-reserve { visibility: hidden; }
  .is-primary .home-nav-label [data-scramble] { position: absolute; inset: 0; overflow: hidden; white-space: nowrap; }
  .is-primary .home-header-actions .home-header-wall {
    position: relative; width: 44px; height: 44px; padding: 0;
    border-color: transparent; color: #aaaab0; background: transparent;
    transition: color .3s ease, background-color .3s ease, border-color .3s ease;
  }
  .is-primary .home-header-wall .home-control-mark { display: inline-flex; width: 22px; height: 22px; flex: none; pointer-events: none; }
  .is-primary .home-header-wall svg { display: block; width: 22px; height: 22px; }
  .is-primary .home-header-wall-label {
    display: block; position: absolute; top: calc(100% + 8px); right: 0;
    width: max-content; padding: 8px 12px; border: 1px solid #383838; border-radius: 12px;
    background: #1f1f1f; color: #ededed; font: 12px/1.5 var(--font-body);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 160ms ease, visibility 160ms;
  }
  .is-primary .home-header-wall:focus-visible .home-header-wall-label { opacity: 1; visibility: visible; }
  .is-primary .home-header-actions .home-header-wall:active { color: #aaaab0; background: #242424; }
  @media (hover:hover) and (pointer:fine) {
    .is-primary .home-header-actions .home-header-wall:hover { color: #aaaab0; background: #1f1f1f; }
    .is-primary .home-header-wall:hover .home-header-wall-label { opacity: 1; visibility: visible; transition-delay: 180ms; }
  }
  @media (min-width:568px) and (max-width:799px) and (max-height:560px) {
    :global(:root:has(.home-header.is-primary)) { --home-header-height: calc(64px + env(safe-area-inset-top,0px)); }
    .home-header.is-primary { grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); grid-template-rows: 48px; gap: 0 12px; }
    .is-primary > nav { grid-column: 2; grid-row: 1; gap: 4px; }
    .is-primary .home-header-actions { grid-column: 3; }
  }
  @media (prefers-reduced-motion:reduce) { nav a::after, .is-primary .home-header-actions .home-header-wall, .is-primary .home-header-wall-label { transition: none; } }
</style>
