---
import { sitePath } from '../../lib/paths';
const links = [{ name: 'Becoming', cn: '学习', path: 'knowledge' }, { name: 'Elsewhere', cn: '常用网站', path: 'links' }, { name: 'Someone', cn: '关于小石', path: 'about' }];
---
<header class="home-header">
  <a class="home-brand" href={sitePath()} aria-label="Little Stone Still Here · 首页">LSSH</a>
  <nav aria-label="主要导航">
    {links.map(({ name, cn, path }) => <a id={`nav-${path}`} href={sitePath(path)} data-home-link aria-label={`${name} · ${cn}`}><span data-scramble={name} aria-hidden="true">{name}</span></a>)}
  </nav>
  <a class="home-header-wall" href={`${sitePath()}#wall`} aria-label="去留言墙"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z" /></svg><span>The Wall</span></a>
</header>
