---
import { homeControlStrokes, homeControlGesture } from '../../lib/home-control-shapes';
import { sitePath } from '../../lib/paths';
import ReturnLink from '../navigation/DivisionBellReturn.astro';
interface Props { journey?: boolean; lang?: 'zh-CN' | 'en'; languageHref?: string; homeHref?: string; }
const { journey = false, lang = 'zh-CN', languageHref, homeHref } = Astro.props;
const pagePath = Astro.url.pathname;
const homeTarget = homeHref ?? `${sitePath()}#${pagePath.includes('/music') ? 'radio' : /\/(showcase|projects)(\/|$)/.test(pagePath) ? 'projects' : 'intro'}`;
const links = [{ name: 'Becoming', cn: '学习', en: 'Learning', path: 'knowledge' }, { name: 'Elsewhere', cn: '常用网站', en: 'Websites', path: 'links' }, { name: 'Someone', cn: '关于小石', en: 'About Little Stone', path: 'about' }];
const isCurrent = (path: string) => pagePath.startsWith(sitePath(path)) || (path === 'about' && pagePath.startsWith(sitePath('zh/about')));
---
<header class:list={['home-header', { 'has-language-switch': Boolean(languageHref), 'has-scene-toolbar': journey }]}>
  <ReturnLink class="home-brand" href={homeTarget} label={lang === 'en' ? 'Home' : '首页'} compact iconOnly />
  <nav aria-label={lang === 'en' ? 'Main navigation' : '主要导航'}>
    {links.map(({ name, cn, en, path }) => <a id={`nav-${path}`} href={sitePath(path === 'about' && lang === 'zh-CN' && languageHref ? 'zh/about' : path)} data-home-link aria-current={isCurrent(path) ? 'page' : undefined} aria-label={`${name} · ${lang === 'en' ? en : cn}`}>
      {journey ? <span class="home-nav-label" aria-hidden="true"><span class="home-nav-reserve">{name}</span><span data-scramble={name} aria-hidden="true">{name}</span></span> : <span data-scramble={name} aria-hidden="true">{name}</span>}
    </a>)}
  </nav>
  <div class="home-header-actions" data-home-control-group={journey ? "" : undefined}>
    <a class="home-header-wall" href={`${sitePath()}#wall`} aria-label={lang === 'en' ? 'Go to The Wall' : '去留言墙'}>{journey ? <span class="home-control-mark" data-home-control-mark data-invite-gesture={homeControlGesture('wall',false)} aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">{homeControlStrokes('wall',false).map(({part,arrow,person}) => <path data-invite-part={part} data-invite-arrow={arrow} data-invite-person={person} d={arrow} />)}</svg></span> : <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z" /></svg>}<span class="home-header-wall-label">The Wall</span></a>
    {languageHref ? <a class="home-language-switch" href={languageHref} hreflang={lang === 'en' ? 'zh-CN' : 'en'} data-language-switch aria-label={lang === 'en' ? 'Switch to Chinese' : '切换为英文'} title={lang === 'en' ? 'Switch to Chinese' : '切换为英文'}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></svg></a> : journey ? <div class="home-scene-toolbar-slot" data-home-scene-toolbar /> : <span class="home-header-aux" aria-hidden="true" />}
  </div>
</header>

<style>
  /* This component owns navigation geometry on every route. */
  .home-header {
    position: fixed; inset: 0 0 auto; z-index: 20;
    display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
    align-items: center; gap: 24px; box-sizing: border-box;
    height: calc(80px + env(safe-area-inset-top,0px));
    padding: calc(16px + env(safe-area-inset-top,0px)) max(24px,calc((100% - 1200px)/2)) 16px;
    background: #000; color: #ededed; border-bottom: 1px solid #242424;
  }
  .home-header a { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; color: inherit; text-decoration: none; white-space: nowrap; touch-action: manipulation; }
  .home-header :global(.home-brand.db-return) { justify-self: start; min-width: 48px; min-height: 48px; height: 48px; padding: 4px; }
  .home-header :global(.home-brand .db-return-glyph-slot) { width: 36px; flex-basis: 36px; }
  nav { display: flex; justify-content: center; gap: 16px; min-width: 0; }
  nav a { position: relative; padding-inline: 8px; font: 400 14px/1.5 'IBM Plex Mono',ui-monospace,monospace; letter-spacing: .04em; }
  nav a::after { content: ''; position: absolute; inset: auto 8px 4px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: center; transition: transform 160ms ease; }
  nav a[aria-current='page']::after { transform: scaleX(1); }
  .home-header-actions { display: grid; grid-template-columns: auto 44px; align-items: center; justify-self: end; gap: 8px; }
  .home-header-wall { gap: 8px; padding: 0 16px; border: 1px solid #777; border-radius: 999px; font: 400 12px/1.5 'IBM Plex Mono',ui-monospace,monospace; letter-spacing: 0; }
  .home-header-wall svg { flex: none; }
  .home-language-switch, .home-header-aux { width: 44px; height: 44px; border-radius: 50%; }
  .home-header :is(a:focus-visible, :global(.home-brand:focus-visible)) { outline: 2px solid currentColor; outline-offset: 3px; }
  nav a:active, .home-language-switch:active { background: #242424; }
  @media (hover:hover) {
    nav a:hover::after { transform: scaleX(1); }
    .home-header-wall:hover { background: #ededed; color: #000; }
    .home-language-switch:hover { background: #242424; }
  }
  @media (max-width:49.999rem) {
    .home-header { height: calc(112px + env(safe-area-inset-top,0px)); padding: calc(8px + env(safe-area-inset-top,0px)) 16px 8px; grid-template-columns: 48px minmax(0,1fr); grid-template-rows: 48px 44px; gap: 4px 16px; }
    nav { grid-column: 1 / -1; grid-row: 2; gap: 16px; }
    nav a { font-size: 13px; letter-spacing: .02em; }
    .home-header-actions { grid-column: 2; grid-row: 1; }
  }
  /* Homepage controls occupy a real header slot, not a viewport overlay. */
  .home-header.has-scene-toolbar .home-header-actions { grid-template-columns: 44px 96px; }
  .home-scene-toolbar-slot { width: 96px; height: 44px; }
  @media (min-width:50rem) and (max-width:68.749rem) {
    .home-header.has-scene-toolbar { gap: 16px; }
  }
  @media (max-width:49.999rem) {
    .home-header.has-scene-toolbar { grid-template-columns: 48px minmax(0,1fr); gap: 4px 16px; }
    .home-header.has-scene-toolbar > nav { justify-self: center; }
  }
  /* Equal framing for the three homepage actions; the circle is hover feedback only. */
  .home-header.has-scene-toolbar .home-header-actions .home-header-wall {
    position: relative; width: 44px; height: 44px; padding: 0;
    border-color: transparent; color: #aaaab0; background: transparent;
  }
  .home-header.has-scene-toolbar .home-header-actions .home-header-wall svg { display: block; width: 22px; height: 22px; }
  .home-header.has-scene-toolbar .home-header-actions .home-header-wall .home-header-wall-label {
    display: block; position: absolute; top: calc(100% + 8px); right: 0;
    width: max-content; padding: 8px 12px; border: 1px solid #383838; border-radius: 12px;
    background: #1f1f1f; color: #ededed; font: 12px/1.5 var(--font-body);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 160ms ease, visibility 160ms;
  }
  .home-header.has-scene-toolbar .home-header-actions .home-header-wall:focus-visible .home-header-wall-label { opacity: 1; visibility: visible; }
  .home-header.has-scene-toolbar .home-header-actions .home-header-wall:active { color: #aaaab0; background: #242424; }
  @media (hover:hover) and (pointer:fine) {
    .home-header.has-scene-toolbar .home-header-actions .home-header-wall:hover { color: #aaaab0; background: #1f1f1f; }
    .home-header.has-scene-toolbar .home-header-actions .home-header-wall:hover .home-header-wall-label { opacity: 1; visibility: visible; transition-delay: 180ms; }
  }
  @media (prefers-reduced-motion:reduce) { .home-header.has-scene-toolbar .home-header-actions .home-header-wall .home-header-wall-label { transition: none; } }
  @media (prefers-reduced-motion:reduce) { nav a::after { transition: none; } }
</style>
