---
import '../../styles/invite.css';
import { homeChapterNumerals, homeChapterStrokes, homeChapterGesture } from '../../lib/home-chapter-shapes';
import type { ChapterId } from './home-chapters';
interface Props { chapter: ChapterId; index: number; }
const { chapter, index } = Astro.props;
const strokes = homeChapterStrokes(chapter,index);
---
<span class="invite-mark home-chapter-mark" data-invite-mark data-chapter-mark={chapter} data-invite-gesture={homeChapterGesture(chapter)} style="--invite-size:26px" aria-hidden="true">
  <span class="home-chapter-numeral">{homeChapterNumerals[index]}</span>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
    {strokes.map(({part,arrow,person}) => <path data-invite-part={part} data-invite-arrow={arrow} data-invite-person={person} d={arrow} />)}
  </svg>
</span>
