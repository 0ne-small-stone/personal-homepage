---
import { giscusConfig, isGiscusConfigured } from '../../config/giscus';
import { sitePath } from '../../lib/paths';
import '../../styles/home-guestbook.css';
const discussionUrl = `https://github.com/${giscusConfig.repo}/discussions?discussions_q=${encodeURIComponent(giscusConfig.term)}`;
---
<div class="home-guestbook" data-home-guestbook data-guestbook-state="idle" data-embed-url={sitePath('guestbook-client')} data-repo={giscusConfig.repo}>
  {isGiscusConfigured ? <>
    <p>使用 GitHub 账号留下话语，留言会公开显示。</p>
    <button id="home-open-guestbook" class="home-cta" type="button" data-open-guestbook aria-haspopup="dialog" aria-controls="home-guestbook-dialog" aria-expanded="false">打开留言</button>
    <dialog id="home-guestbook-dialog" class="home-guestbook-dialog" aria-labelledby="home-guestbook-title" aria-describedby="home-guestbook-description" data-lenis-prevent>
      <header class="home-guestbook-heading">
        <span class="home-guestbook-eyebrow">The Wall</span>
        <h2 id="home-guestbook-title">留下你的回声</h2>
        <p id="home-guestbook-description">在这里相遇的话语，会留在同一面墙上。</p>
        <button type="button" class="home-guestbook-close" data-close-guestbook aria-label="收起留言" autofocus><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 10 10M14 4 4 14" /></svg></button>
      </header>
      <div class="home-guestbook-scroll" data-lenis-prevent tabindex="0" role="region" aria-label="留言内容滚动区">
        <p data-guestbook-status role="status" aria-live="polite"></p>
        <p class="home-guestbook-fixture" data-guestbook-fixture hidden>本地失败夹具，仅用于验证重试。</p>
        <button type="button" class="home-guestbook-retry" data-retry-guestbook hidden>重新连接</button>
        <div data-guestbook-mount aria-busy="false"></div>
        <a class="home-discussion-link" data-guestbook-discussion href={discussionUrl} target="_blank" rel="noopener noreferrer">在 GitHub 查看此留言区<span class="sr-only">（新窗口）</span></a>
      </div>
    </dialog>
  </> : <><p>留言区暂未开放。</p><p class="home-description">接通后，用 GitHub 账号留下话语，与后来的人相遇。</p></>}
  <a class="home-discussion-link" href={discussionUrl} target="_blank" rel="noopener noreferrer">查看 GitHub 留言<span class="sr-only">（新窗口）</span></a>
</div>
<script>
  import './home-guestbook';
</script>
