---
import InviteMark from '../navigation/InviteMark.astro';
interface Props { href: string; label: string; id?: string; }
const { href, label, id } = Astro.props;
---
<a class="home-cta" href={href} id={id} aria-label={label} data-home-link>
  <span class="home-cta-clip" aria-hidden="true"><span>{label}</span><span>{label}</span></span>
  <InviteMark />
</a>
