---
import { sitePath } from '../lib/paths';
---
<nav class="article-navigation" aria-label="文章阅读导航" data-pagefind-ignore>
  <a data-article-return href={sitePath('knowledge/blog')}>← 返回文章列表</a>
  <a href={`${sitePath('knowledge')}?type=article`}>学习总览 · 文章</a>
</nav>
<style>
  .article-navigation { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-bottom: var(--space-5); }
  a { display: inline-flex; align-items: center; min-height: var(--target-min); font-weight: 500; }
</style>
