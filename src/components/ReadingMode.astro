---
interface Props { pdf?: boolean; }
const { pdf = false } = Astro.props;
---
<learning-reading-mode data-reading-kind={pdf ? 'pdf' : 'content'} data-pagefind-ignore hidden>
  <div class="reading-mode-actions" role="group" aria-label="阅读模式">
    <button type="button" data-focus-mode aria-pressed="false" aria-describedby="reading-mode-help">沉浸阅读</button>
  </div>
  <p id="reading-mode-help" data-reading-status role="status" aria-live="polite">进入全屏，电脑 Esc 退出，手机右滑退出。PDF 可用 Ctrl + 加减号或 Ctrl + 滚轮缩放。</p>
</learning-reading-mode>
<script>
  interface PdfViewer {
    pdfDocument?: unknown;
    scrollMode: number;
    spreadMode: number;
    currentPageNumber: number;
    currentScaleValue: string;
    scrollPageIntoView(options: { pageNumber: number }): void;
    update(): void;
  }
  interface PdfApplication {
    pdfViewer?: PdfViewer;
    findBar?: { close(): void };
    secondaryToolbar?: { close(): void };
  }
  type PdfWindow = Window & { PDFViewerApplication?: PdfApplication };
  class LearningReadingMode extends HTMLElement {
    private controller?: AbortController;
    private frameController?: AbortController;
    private observer?: MutationObserver;
    private resizeObserver?: ResizeObserver;
    private button!: HTMLButtonElement;
    private status!: HTMLElement;
    private frame?: HTMLIFrameElement;
    private active = false;
    private pending = false;
    private nativeFullscreen = false;
    private mobileSession = false;
    private scrollY = 0;
    private savedPdf?: { scrollMode: number; spreadMode: number; sidebar: boolean; page: number };
    private pdfMoved = false;
    private readingFocus?: { element: HTMLElement; tabindex: string | null };
    private get app() {
      try { return (this.frame?.contentWindow as PdfWindow | null)?.PDFViewerApplication; }
      catch { return undefined; }
    }
    private mobile() { return matchMedia('(any-pointer: coarse)').matches || matchMedia('(max-width: 48rem)').matches; }
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.button = this.querySelector('[data-focus-mode]')!;
      this.status = this.querySelector('[data-reading-status]')!;
      this.frame = document.querySelector<HTMLIFrameElement>('pdf-reader iframe') ?? undefined;
      this.active = false;
      this.hidden = false;
      this.resizeObserver = new ResizeObserver(() => document.documentElement.style.setProperty('--reading-toolbar-height', this.offsetHeight + 'px'));
      this.resizeObserver.observe(this);
      this.button.addEventListener('click', () => this.enter(), { signal });
      document.addEventListener('fullscreenchange', () => {
        if (this.active && this.nativeFullscreen && !document.fullscreenElement) this.restore();
      }, { signal });
      this.bindInput(document, signal);
      if (this.frame) {
        const bind = () => {
          this.frameController?.abort();
          this.frameController = new AbortController();
          const frameDocument = this.frame?.contentDocument;
          if (frameDocument) this.bindInput(frameDocument, this.frameController.signal);
          this.updateAvailability();
        };
        this.frame.addEventListener('load', bind, { signal });
        bind();
        const reader = this.frame.closest('pdf-reader')!;
        this.observer = new MutationObserver(() => {
          if (this.active && !reader.querySelector<HTMLElement>('[data-error]')?.hidden) this.exit();
          this.updateAvailability();
        });
        this.observer.observe(reader, { attributes: true, attributeFilter: ['aria-busy'] });
      }
      window.addEventListener('pageshow', () => this.updateAvailability(), { signal });
      window.addEventListener('pagehide', () => this.restore(), { signal });
      this.updateAvailability();
    }
    private updateAvailability() {
      const needsPdf = this.dataset.readingKind === 'pdf';
      const ready = !needsPdf || (!!this.app?.pdfViewer?.pdfDocument && this.frame?.closest('pdf-reader')?.getAttribute('aria-busy') === 'false');
      this.button.disabled = this.pending || !ready || (!document.fullscreenEnabled && !this.mobile());
      if (this.active) return;
      if (!ready) this.status.textContent = this.frame ? 'PDF 加载完成后可进入沉浸阅读。' : 'PDF 附件尚未接入，暂时无法进入沉浸阅读。';
      else if (!document.fullscreenEnabled && this.mobile()) this.status.textContent = '此浏览器不支持系统全屏，将铺满网页阅读；右滑退出。';
      else if (!document.fullscreenEnabled) this.status.textContent = '此浏览器不支持网页全屏，无法进入沉浸阅读。';
      else this.status.textContent = '进入全屏，电脑 Esc 退出，手机右滑退出。PDF 可用 Ctrl + 加减号或 Ctrl + 滚轮缩放。';
    }
    private bindInput(doc: Document, signal: AbortSignal) {
      doc.addEventListener('keydown', (event) => {
        if (!this.active) return;
        if (event.key === 'Escape') {
          event.preventDefault(); this.exit();
          return;
        }
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp', 'PageDown', 'Home', 'End'].includes(event.key)) this.pdfMoved = true;
        if ((event.ctrlKey || event.metaKey) && ['k', 'f', 'g', 'p'].includes(event.key.toLowerCase())) {
          if (event.key.toLowerCase() === 'p' && !event.altKey) return;
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, { signal, capture: true });
      doc.addEventListener('wheel', (event) => { if (this.active && !event.ctrlKey) this.pdfMoved = true; }, { signal, passive: true });
      let start: { id: number; x: number; y: number; time: number } | undefined;
      doc.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary) { start = undefined; return; }
        if (this.active && this.mobileSession && event.button === 0) start = { id: event.pointerId, x: event.clientX, y: event.clientY, time: event.timeStamp };
      }, { signal, capture: true });
      doc.addEventListener('pointercancel', () => { start = undefined; }, { signal, capture: true });
      doc.addEventListener('pointermove', (event) => {
        if (start && event.pointerType !== 'mouse' && event.pointerId === start.id && Math.abs(event.clientY - start.y) > 10) this.pdfMoved = true;
      }, { signal, capture: true });
      doc.addEventListener('pointerup', (event) => {
        const origin = start; start = undefined;
        if (!origin || event.pointerId !== origin.id || !this.active) return;
        const dx = event.clientX - origin.x, dy = Math.abs(event.clientY - origin.y);
        if (dx >= Math.max(80, (doc.defaultView?.innerWidth ?? innerWidth) * 0.22) && dx > dy * 2 && dy <= 50 && event.timeStamp - origin.time <= 1000) {
          event.preventDefault(); this.exit();
        }
      }, { signal, capture: true });
    }
    private async enter() {
      if (this.active || this.pending || this.button.disabled) return;
      this.pending = true;
      this.mobileSession = this.mobile();
      this.scrollY = window.scrollY;
      this.nativeFullscreen = !!document.fullscreenEnabled;
      this.pdfMoved = false;
      const anchor = this.frame ? undefined : this.readingAnchor(this.getBoundingClientRect().bottom + 16);
      const viewer = this.app?.pdfViewer, frameDoc = this.frame?.contentDocument;
      try {
        this.active = true;
        document.documentElement.setAttribute('data-reading-immersive', '');
        document.documentElement.toggleAttribute('data-reading-pdf', !!this.frame);
        document.documentElement.toggleAttribute('data-reading-touch', this.mobileSession);
        if (viewer && frameDoc) {
          const panel = frameDoc.getElementById('viewsManager');
          this.savedPdf = { scrollMode: viewer.scrollMode, spreadMode: viewer.spreadMode, sidebar: !!panel && !panel.hidden, page: viewer.currentPageNumber };
          if (this.savedPdf.sidebar) frameDoc.getElementById('viewsManagerToggleButton')?.click();
          this.app?.findBar?.close();
          this.app?.secondaryToolbar?.close();
          frameDoc.documentElement.setAttribute('data-reading-immersive', '');
          frameDoc.documentElement.toggleAttribute('data-reading-touch', this.mobileSession);
          viewer.spreadMode = 0;
          viewer.scrollMode = 2; // Native Wrapped mode: columns follow scale/viewport.
        }
        this.button.setAttribute('aria-pressed', 'true');
        // Keep requestFullscreen in the initiating user gesture.
        if (this.nativeFullscreen) await document.documentElement.requestFullscreen();
        if (this.active) {
          viewer?.update();
          if (frameDoc) frameDoc.getElementById('viewerContainer')?.focus({ preventScroll: true });
          else {
            const readingFrame = document.querySelector<HTMLElement>('.main-frame');
            if (readingFrame && anchor) readingFrame.scrollTop += anchor.element.getBoundingClientRect().top - Math.max(24, anchor.top);
            if (readingFrame) {
              this.readingFocus = { element: readingFrame, tabindex: readingFrame.getAttribute('tabindex') };
              readingFrame.setAttribute('tabindex', '-1');
              readingFrame.focus({ preventScroll: true });
            }
          }
        }
      } catch {
        this.restore();
        this.status.textContent = '无法进入全屏，请重试或使用支持全屏的浏览器。';
      } finally {
        this.pending = false;
        this.button.disabled = false;
      }
    }
    private async exit() {
      if (!this.active) return;
      if (document.fullscreenElement) {
        try { await document.exitFullscreen(); } catch { return; }
      }
      this.restore();
    }
    private restore() {
      if (!this.active) return;
      const anchor = this.frame ? undefined : this.readingAnchor(24);
      this.active = false;
      const viewer = this.app?.pdfViewer, frameDoc = this.frame?.contentDocument;
      const page = this.pdfMoved ? viewer?.currentPageNumber : (this.savedPdf?.page ?? viewer?.currentPageNumber);
      for (const attribute of ['data-reading-immersive', 'data-reading-pdf', 'data-reading-touch']) document.documentElement.removeAttribute(attribute);
      frameDoc?.documentElement.removeAttribute('data-reading-immersive');
      frameDoc?.documentElement.removeAttribute('data-reading-touch');
      if (viewer && this.savedPdf && page) {
        viewer.spreadMode = this.savedPdf.spreadMode;
        viewer.scrollMode = this.savedPdf.scrollMode;
        viewer.scrollPageIntoView({ pageNumber: page });
        viewer.update();
        if (this.savedPdf.sidebar) frameDoc?.getElementById('viewsManagerToggleButton')?.click();
      }
      this.savedPdf = undefined;
      if (this.readingFocus) {
        if (this.readingFocus.tabindex === null) this.readingFocus.element.removeAttribute('tabindex');
        else this.readingFocus.element.setAttribute('tabindex', this.readingFocus.tabindex);
        this.readingFocus = undefined;
      }
      window.scrollTo({ top: this.scrollY, behavior: 'instant' });
      this.button.setAttribute('aria-pressed', 'false');
      this.updateAvailability();
      if (anchor) window.scrollBy({ top: anchor.element.getBoundingClientRect().top - Math.max(anchor.top, this.getBoundingClientRect().bottom + 16), behavior: 'instant' });
      this.button.focus({ preventScroll: true });
    }
    private readingAnchor(top: number) {
      const element = Array.from(document.querySelectorAll<HTMLElement>('.sl-markdown-content :is(h2, h3, p, li, pre)'))
        .find((candidate) => candidate.getBoundingClientRect().height > 0 && candidate.getBoundingClientRect().top >= top);
      return element ? { element, top: element.getBoundingClientRect().top } : undefined;
    }
    disconnectedCallback() {
      this.restore();
      this.controller?.abort();
      this.frameController?.abort();
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      document.documentElement.style.removeProperty('--reading-toolbar-height');
    }
  }
  if (!customElements.get('learning-reading-mode')) customElements.define('learning-reading-mode', LearningReadingMode);
</script>
