---
interface Props { pdf?: boolean; }
const { pdf = false } = Astro.props;
---
<learning-reading-mode data-reading-kind={pdf ? 'pdf' : 'content'} data-pagefind-ignore hidden>
  <div class="reading-mode-actions" role="group" aria-label="阅读模式">
    <button type="button" data-focus-mode aria-pressed="false" aria-describedby="reading-mode-help">沉浸阅读</button>
  </div>
  {pdf ? <details class="reading-mode-help">
    <summary>阅读快捷键</summary>
  <p id="reading-mode-help" data-reading-status role="status" aria-live="polite">进入全屏，电脑 Esc 退出，手机右滑退出。PDF 可用 Ctrl + 加减号或 Ctrl + 滚轮缩放。</p>
  </details> : <p id="reading-mode-help" data-reading-status role="status" aria-live="polite">进入全屏，电脑 Esc 退出，手机右滑退出。PDF 可用 Ctrl + 加减号或 Ctrl + 滚轮缩放。</p>}
</learning-reading-mode>
<script>
  import { automaticPdfColumns, fitPdfMode, pdfModeGeometry, pdfModeGroup, type PdfPaperSize } from '../lib/immersivePdfLayout';
  import { immersivePdfShortcut } from '../lib/immersivePdfShortcuts';
  interface PdfPageView {
    div: HTMLElement;
    scale: number;
    viewport: { width: number; height: number; convertToPdfPoint(x: number, y: number): number[] };
  }
  interface PdfBookmark { page: number; x: number; y: number; }
  type PdfListener = (event: { location?: { pageNumber: number; left: number; top: number }; scale?: number }) => void;
  interface PdfViewer {
    pdfDocument?: { getPage(page: number): Promise<{ rotate: number; getViewport(options: { scale: number; rotation: number }): PdfPaperSize }> };
    scrollMode: number;
    spreadMode: number;
    currentPageNumber: number;
    currentScaleValue: string;
    currentScale: number;
    pagesRotation: number;
    pagesCount: number;
    getPageView(index: number): PdfPageView | undefined;
    scrollPageIntoView(options: { pageNumber: number; destArray?: unknown[]; ignoreDestinationZoom?: boolean }): void;
    update(): void;
  }
  interface PdfApplication {
    pdfViewer?: PdfViewer;
    eventBus?: { on(name: string, listener: PdfListener): void; off(name: string, listener: PdfListener): void };
    findBar?: { close(): void };
    secondaryToolbar?: { close(): void };
  }
  type PdfWindow = Window & { PDFViewerApplication?: PdfApplication };
  class LearningReadingMode extends HTMLElement {
    private controller?: AbortController;
    private frameController?: AbortController;
    private observer?: MutationObserver;
    private resizeObserver?: ResizeObserver;
    private pdfResizeObserver?: ResizeObserver;
    private fitTimer?: number;
    private trackedBus?: PdfApplication['eventBus'];
    private lastBookmark?: PdfBookmark;
    private resizeBookmark?: PdfBookmark;
    private resizing = false;
    private columns?: number;
    private modeChosen = false;
    private freeFlow = false;
    private groupSizes: PdfPaperSize[] = [];
    private modeFits = false;
    private fitEpoch = 0;
    private geometryFrame?: number;
    private lastWheel = -Infinity;
    private button!: HTMLButtonElement;
    private status!: HTMLElement;
    private frame?: HTMLIFrameElement;
    private active = false;
    private pending = false;
    private nativeFullscreen = false;
    private mobileSession = false;
    private scrollY = 0;
    private savedPdf?: { scrollMode: number; spreadMode: number; sidebar: boolean; page: number; scale: string; bookmark?: PdfBookmark };
    private automatic = true;
    private manualZoom = false;
    private pdfMoved = false;
    private readingFocus?: { element: HTMLElement; tabindex: string | null };
    private get app() {
      try { return (this.frame?.contentWindow as PdfWindow | null)?.PDFViewerApplication; }
      catch { return undefined; }
    }
    private mobile() { return matchMedia('(any-pointer: coarse)').matches || matchMedia('(max-width: 48rem)').matches; }
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.button = this.querySelector('[data-focus-mode]')!;
      this.status = this.querySelector('[data-reading-status]')!;
      this.frame = document.querySelector<HTMLIFrameElement>('pdf-reader iframe') ?? undefined;
      this.active = false;
      this.hidden = false;
      this.resizeObserver = new ResizeObserver(() => document.documentElement.style.setProperty('--reading-toolbar-height', this.offsetHeight + 'px'));
      this.resizeObserver.observe(this);
      this.button.addEventListener('click', () => this.enter(), { signal });
      document.addEventListener('fullscreenchange', () => {
        if (this.active && this.nativeFullscreen && !document.fullscreenElement) this.restore();
      }, { signal });
      this.bindInput(document, signal);
      if (this.frame) {
        const bind = () => {
          this.frameController?.abort();
          this.frameController = new AbortController();
          const frameDocument = this.frame?.contentDocument;
          if (frameDocument) this.bindInput(frameDocument, this.frameController.signal);
          frameDocument?.defaultView?.addEventListener('resize', () => {
            if (!this.active || this.pending) return;
            this.resizing = true;
            this.resizeBookmark ??= this.lastBookmark ?? this.bookmarkPdf();
            this.scheduleFit();
          }, { signal: this.frameController.signal, capture: true });
          this.pdfResizeObserver?.disconnect();
          const container = frameDocument?.getElementById('viewerContainer');
          if (container) {
            this.pdfResizeObserver = new ResizeObserver(() => this.scheduleFit());
            this.pdfResizeObserver.observe(container);
          }
          this.updateAvailability();
        };
        this.frame.addEventListener('load', bind, { signal });
        bind();
        const reader = this.frame.closest('pdf-reader')!;
        this.observer = new MutationObserver(() => {
          if (this.active && !reader.querySelector<HTMLElement>('[data-error]')?.hidden) this.exit();
          this.updateAvailability();
        });
        this.observer.observe(reader, { attributes: true, attributeFilter: ['aria-busy'] });
      }
      window.addEventListener('pageshow', () => this.updateAvailability(), { signal });
      window.addEventListener('pagehide', () => this.restore(), { signal });
      this.updateAvailability();
    }
    private updateAvailability() {
      const needsPdf = this.dataset.readingKind === 'pdf';
      const ready = !needsPdf || (!!this.app?.pdfViewer?.pdfDocument && this.frame?.closest('pdf-reader')?.getAttribute('aria-busy') === 'false');
      this.button.disabled = this.pending || !ready || (!document.fullscreenEnabled && !this.mobile());
      if (this.active) return;
      if (!ready) this.status.textContent = this.frame ? 'PDF 加载完成后可进入沉浸阅读。' : 'PDF 附件尚未接入，暂时无法进入沉浸阅读。';
      else if (!document.fullscreenEnabled && this.mobile()) this.status.textContent = '此浏览器不支持系统全屏，将铺满网页阅读；右滑退出。';
      else if (!document.fullscreenEnabled) this.status.textContent = '此浏览器不支持网页全屏，无法进入沉浸阅读。';
      else if (this.frame) {
        const strategy = this.freeFlow ? '当前自由排布，页数随缩放变化。' : this.columns
          ? `当前每组 ${this.columns} 页，缩放不会改变页数。`
          : '进入后自动选择单页或双页，并显示完整页面。';
        this.status.textContent = strategy + '数字键 1–4 固定页数，0、5–9 取消固定；F 适应整页（中文输入法也可用）。固定时方向键/滚轮翻组；Ctrl + 加减号或 Ctrl + 滚轮缩放。电脑 Esc、手机右滑退出。';
      } else this.status.textContent = '进入全屏，电脑 Esc 退出，手机右滑退出。';
    }
    private bookmarkPdf(): PdfBookmark | undefined {
      const viewer = this.app?.pdfViewer;
      const page = viewer?.getPageView(viewer.currentPageNumber - 1);
      const container = this.frame?.contentDocument?.getElementById('viewerContainer');
      if (!viewer || !page || !container) return;
      const paper = page.div.getBoundingClientRect(), area = container.getBoundingClientRect();
      const x = Math.max(0, Math.min(page.viewport.width, area.left - paper.left - page.div.clientLeft));
      const y = Math.max(0, Math.min(page.viewport.height, area.top - paper.top - page.div.clientTop));
      const point = page.viewport.convertToPdfPoint(x, y);
      return { page: viewer.currentPageNumber, x: point[0], y: point[1] };
    }
    private restorePdfBookmark(bookmark?: PdfBookmark) {
      if (!bookmark) return;
      this.app?.pdfViewer?.scrollPageIntoView({
        pageNumber: bookmark.page,
        destArray: [null, { name: 'XYZ' }, bookmark.x, bookmark.y, null],
        ignoreDestinationZoom: true,
      });
    }
    private trackPdfLocation() {
      const bus = this.app?.eventBus;
      if (!bus || bus === this.trackedBus) return;
      const listener: PdfListener = ({ location }) => {
        if (!location || !this.active || this.pending || this.resizing) return;
        this.lastBookmark = !this.pdfMoved && this.savedPdf?.bookmark ? this.savedPdf.bookmark
          : { page: location.pageNumber, x: location.left, y: location.top };
      };
      const scaleListener: PdfListener = ({ scale }) => {
        if (!this.active || !scale) return;
        this.applyPdfGeometry(scale);
        if (this.geometryFrame) cancelAnimationFrame(this.geometryFrame);
        this.geometryFrame = requestAnimationFrame(() => {
          this.geometryFrame = undefined;
          if (this.active && !this.resizing && this.modeFits) this.alignPdfGroup(this.currentPdfPage());
        });
      };
      bus.on('updateviewarea', listener);
      bus.on('scalechanging', scaleListener);
      // PDF.js checks its own realm's AbortSignal; explicitly detach our listener.
      this.frameController?.signal.addEventListener('abort', () => {
        bus.off('updateviewarea', listener);
        bus.off('scalechanging', scaleListener);
        if (this.trackedBus === bus) this.trackedBus = undefined;
      }, { once: true });
      this.trackedBus = bus;
    }
    private currentPdfPage() { return this.lastBookmark?.page ?? this.app?.pdfViewer?.currentPageNumber ?? 1; }
    private clearPdfGeometry() {
      const root = this.frame?.contentDocument?.documentElement;
      root?.removeAttribute('data-reading-columns');
      for (const property of ['--reading-columns', '--reading-cell-width', '--reading-slot-height']) root?.style.removeProperty(property);
      this.modeFits = false;
    }
    private applyPdfGeometry(scale = this.app?.pdfViewer?.currentScale ?? 1) {
      if (this.freeFlow) return;
      const doc = this.frame?.contentDocument, container = doc?.getElementById('viewerContainer');
      if (!doc || !container || !this.columns || !this.groupSizes.length) return;
      const geometry = pdfModeGeometry({ width: container.clientWidth, height: container.clientHeight,
        columns: this.columns, sizes: this.groupSizes, scale });
      if (!geometry) return;
      doc.documentElement.style.setProperty('--reading-columns', String(this.columns));
      doc.documentElement.style.setProperty('--reading-cell-width', geometry.cellWidth + 'px');
      doc.documentElement.style.setProperty('--reading-slot-height', geometry.slotHeight + 'px');
      doc.documentElement.dataset.readingColumns = String(this.columns);
      this.modeFits = geometry.fits;
    }
    private alignPdfGroup(page: number) {
      const viewer = this.app?.pdfViewer, container = this.frame?.contentDocument?.getElementById('viewerContainer');
      const paper = viewer?.getPageView(page - 1)?.div;
      if (!viewer || !container || !paper) return;
      viewer.scrollPageIntoView({ pageNumber: page });
      container.scrollTop = Math.max(0, this.modeFits || (this.freeFlow && paper.offsetHeight <= container.clientHeight)
        ? paper.offsetTop + paper.offsetHeight / 2 - container.clientHeight / 2 : paper.offsetTop - 8);
      viewer.update();
    }
    private async fitPdf(bookmark = this.lastBookmark ?? this.bookmarkPdf(), fit = true) {
      if (!this.active || (fit && !this.automatic)) return;
      const viewer = this.app?.pdfViewer, doc = this.frame?.contentDocument;
      const container = doc?.getElementById('viewerContainer');
      const pageNumber = bookmark?.page ?? viewer?.currentPageNumber ?? 1;
      const page = viewer?.getPageView(pageNumber - 1);
      if (!viewer?.pdfDocument || !page || !container || !doc) return;
      if (!this.freeFlow) this.columns ??= automaticPdfColumns(container.clientWidth, container.clientHeight,
        { width: page.viewport.width, height: page.viewport.height }, viewer.pagesCount);
      const columns = Math.min(this.freeFlow ? 1 : this.columns!, viewer.pagesCount);
      if (!this.freeFlow) this.columns = columns;
      const epoch = ++this.fitEpoch;
      this.resizing = true;
      doc.documentElement.setAttribute('data-reading-layout-pending', '');
      try {
        const group = pdfModeGroup(pageNumber, viewer.pagesCount, columns);
        const sizes = await Promise.all(group.map(async (number) => {
          const paper = await viewer.pdfDocument!.getPage(number);
          const viewport = paper.getViewport({ scale: 4 / 3, rotation: (paper.rotate + viewer.pagesRotation) % 360 });
          return { width: viewport.width, height: viewport.height };
        }));
        if (!this.active || (fit && !this.automatic) || epoch !== this.fitEpoch) return;
        const input = { width: container.clientWidth, height: container.clientHeight, sizes, columns };
        const scale = fit ? fitPdfMode(input)?.scale : viewer.currentScale;
        if (!scale || !pdfModeGeometry({ ...input, scale })) throw new Error('Invalid reading area');
        this.groupSizes = sizes;
        if (fit) viewer.currentScaleValue = String(scale);
        this.applyPdfGeometry(scale);
        this.alignPdfGroup(pageNumber);
        this.lastBookmark = this.pdfMoved ? this.bookmarkPdf() : this.savedPdf?.bookmark;
      } catch {
        if (this.active && epoch === this.fitEpoch) { await this.exit(); this.status.textContent = '无法读取这一组 PDF 页面，请重试。'; }
      } finally {
        if (epoch === this.fitEpoch) { this.resizing = false; doc.documentElement.removeAttribute('data-reading-layout-pending'); }
      }
    }
    private scheduleFit() {
      if (!this.active || this.pending) return;
      if (this.fitTimer) window.clearTimeout(this.fitTimer);
      this.fitTimer = window.setTimeout(() => {
        this.fitTimer = undefined;
        const bookmark = this.resizeBookmark ?? this.lastBookmark ?? this.bookmarkPdf();
        if (this.automatic) void this.fitPdf(bookmark);
        else { this.applyPdfGeometry(); this.restorePdfBookmark(bookmark); this.app?.pdfViewer?.update(); this.lastBookmark = bookmark;
          if (this.modeFits) this.alignPdfGroup(bookmark?.page ?? this.currentPdfPage()); }
        this.resizeBookmark = undefined;
        if (!this.automatic) this.resizing = false;
      }, 120);
    }
    private useManualZoom() {
      if (!this.active || !this.frame) return;
      this.automatic = false;
      this.manualZoom = true;
      this.fitEpoch++;
      if (this.fitTimer) window.clearTimeout(this.fitTimer);
      this.fitTimer = undefined;
      this.resizeBookmark = undefined;
      this.resizing = false;
      this.frame.contentDocument?.documentElement.removeAttribute('data-reading-layout-pending');
    }
    private choosePdfMode(columns: number) {
      if (!this.frame) return;
      this.freeFlow = false;
      this.columns = Math.min(columns, this.app?.pdfViewer?.pagesCount ?? columns);
      this.modeChosen = true;
      this.automatic = true;
      this.manualZoom = false;
      void this.fitPdf();
    }
    private releasePdfMode() {
      const bookmark = this.lastBookmark ?? this.bookmarkPdf();
      this.useManualZoom();
      this.freeFlow = true;
      this.columns = undefined;
      this.modeChosen = false;
      this.groupSizes = [];
      this.clearPdfGeometry();
      this.restorePdfBookmark(bookmark);
      this.app?.pdfViewer?.update();
      this.lastBookmark = bookmark;
    }
    private movePdfGroup(direction: number) {
      const viewer = this.app?.pdfViewer;
      if (!viewer || !this.columns) return;
      const group = pdfModeGroup(this.currentPdfPage(), viewer.pagesCount, this.columns);
      const target = direction > 0 ? group[0] + this.columns : group[0] - this.columns;
      if (target < 1 || target > viewer.pagesCount) return;
      this.pdfMoved = true;
      if (this.automatic) void this.fitPdf({ page: target, x: 0, y: 0 });
      else void this.fitPdf({ page: target, x: 0, y: 0 }, false);
    }
    private bindInput(doc: Document, signal: AbortSignal) {
      doc.addEventListener('keydown', (event) => {
        if (!this.active) return;
        if (event.key === 'Escape') {
          event.preventDefault(); this.exit();
          return;
        }
        const target = event.target as Element | null;
        const editing = target?.nodeType === 1 && !!target.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])');
        if (this.frame && !editing && !event.ctrlKey && !event.metaKey && !event.altKey) {
          const shortcut = immersivePdfShortcut(event);
          if (shortcut) {
            event.preventDefault(); event.stopImmediatePropagation();
            if (shortcut.kind === 'mode') this.choosePdfMode(shortcut.columns);
            else if (shortcut.kind === 'free') this.releasePdfMode();
            else { this.automatic = true; this.manualZoom = false; void this.fitPdf(); }
            return;
          }
          if (this.modeFits && ['ArrowLeft', 'ArrowUp', 'PageUp', 'ArrowRight', 'ArrowDown', 'PageDown'].includes(event.key)) {
            event.preventDefault(); event.stopImmediatePropagation(); this.movePdfGroup(['ArrowLeft', 'ArrowUp', 'PageUp'].includes(event.key) ? -1 : 1); return;
          }
        }
        if ((event.ctrlKey || event.metaKey) && ['+', '=', '-', '_', '0'].includes(event.key)) this.useManualZoom();
        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp', 'PageDown', 'Home', 'End'].includes(event.key)) this.pdfMoved = true;
        if ((event.ctrlKey || event.metaKey) && ['k', 'f', 'g', 'p'].includes(event.key.toLowerCase())) {
          if (event.key.toLowerCase() === 'p' && !event.altKey) return;
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, { signal, capture: true });
      doc.addEventListener('wheel', (event) => {
        if (!this.active) return;
        if (event.ctrlKey || event.metaKey) this.useManualZoom();
        else if (this.frame && this.modeFits && Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
          event.preventDefault();
          if (event.timeStamp - this.lastWheel >= 250) { this.lastWheel = event.timeStamp; this.movePdfGroup(event.deltaY > 0 ? 1 : -1); }
        } else this.pdfMoved = true;
      }, { signal, passive: false, capture: true });
      let start: { id: number; x: number; y: number; time: number } | undefined;
      doc.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary) { start = undefined; if (event.pointerType === 'touch') this.useManualZoom(); return; }
        if (this.active && this.mobileSession && event.button === 0) start = { id: event.pointerId, x: event.clientX, y: event.clientY, time: event.timeStamp };
      }, { signal, capture: true });
      doc.addEventListener('pointercancel', () => { start = undefined; }, { signal, capture: true });
      doc.addEventListener('pointermove', (event) => {
        if (start && event.pointerType !== 'mouse' && event.pointerId === start.id && Math.abs(event.clientY - start.y) > 10) this.pdfMoved = true;
      }, { signal, capture: true });
      doc.addEventListener('pointerup', (event) => {
        const origin = start; start = undefined;
        if (!origin || event.pointerId !== origin.id || !this.active) return;
        const dx = event.clientX - origin.x, dy = Math.abs(event.clientY - origin.y);
        if (dx >= Math.max(80, (doc.defaultView?.innerWidth ?? innerWidth) * 0.22) && dx > dy * 2 && dy <= 50 && event.timeStamp - origin.time <= 1000) {
          event.preventDefault(); this.exit();
        }
      }, { signal, capture: true });
    }
    private async enter() {
      if (this.active || this.pending || this.button.disabled) return;
      this.pending = true;
      this.mobileSession = this.mobile();
      this.scrollY = window.scrollY;
      this.nativeFullscreen = !!document.fullscreenEnabled;
      this.pdfMoved = false;
      this.manualZoom = false;
      if (this.automatic && !this.modeChosen) this.columns = undefined;
      const anchor = this.frame ? undefined : this.readingAnchor(this.getBoundingClientRect().bottom + 16);
      const viewer = this.app?.pdfViewer, frameDoc = this.frame?.contentDocument;
      try {
        this.active = true;
        document.documentElement.setAttribute('data-reading-immersive', '');
        document.documentElement.toggleAttribute('data-reading-pdf', !!this.frame);
        document.documentElement.toggleAttribute('data-reading-touch', this.mobileSession);
        if (viewer && frameDoc) {
          const panel = frameDoc.getElementById('viewsManager');
          this.savedPdf = { scrollMode: viewer.scrollMode, spreadMode: viewer.spreadMode, sidebar: !!panel && !panel.hidden, page: viewer.currentPageNumber,
            scale: viewer.currentScaleValue, bookmark: this.bookmarkPdf() };
          this.lastBookmark = this.savedPdf.bookmark;
          this.trackPdfLocation();
          if (this.savedPdf.sidebar) frameDoc.getElementById('viewsManagerToggleButton')?.click();
          this.app?.findBar?.close();
          this.app?.secondaryToolbar?.close();
          frameDoc.documentElement.setAttribute('data-reading-immersive', '');
          frameDoc.documentElement.toggleAttribute('data-reading-touch', this.mobileSession);
          viewer.spreadMode = 0;
            viewer.scrollMode = 2; // Native rendering; our grid keeps the chosen columns fixed.
        }
        this.button.setAttribute('aria-pressed', 'true');
        // Keep requestFullscreen in the initiating user gesture.
        if (this.nativeFullscreen) await document.documentElement.requestFullscreen();
        if (this.active) {
          viewer?.update();
          if (this.automatic) await this.fitPdf(this.savedPdf?.bookmark);
            else if (this.freeFlow) { this.restorePdfBookmark(this.savedPdf?.bookmark); viewer?.update(); }
            else { this.applyPdfGeometry(); this.alignPdfGroup(this.savedPdf?.page ?? viewer?.currentPageNumber ?? 1); }
          if (frameDoc) frameDoc.getElementById('viewerContainer')?.focus({ preventScroll: true });
          else {
            const readingFrame = document.querySelector<HTMLElement>('.main-frame');
            if (readingFrame && anchor) readingFrame.scrollTop += anchor.element.getBoundingClientRect().top - Math.max(24, anchor.top);
            if (readingFrame) {
              this.readingFocus = { element: readingFrame, tabindex: readingFrame.getAttribute('tabindex') };
              readingFrame.setAttribute('tabindex', '-1');
              readingFrame.focus({ preventScroll: true });
            }
          }
        }
      } catch {
        this.restore();
        this.status.textContent = '无法进入全屏，请重试或使用支持全屏的浏览器。';
      } finally {
        this.pending = false;
        this.button.disabled = false;
        if (this.active) this.scheduleFit();
      }
    }
    private async exit() {
      if (!this.active) return;
      if (document.fullscreenElement) {
        try { await document.exitFullscreen(); } catch { return; }
      }
      this.restore();
    }
    private restore() {
      if (!this.active) return;
      const anchor = this.frame ? undefined : this.readingAnchor(24);
      const bookmark = this.pdfMoved ? (this.lastBookmark ?? this.bookmarkPdf()) : this.savedPdf?.bookmark;
      this.active = false;
      this.fitEpoch++;
      if (this.geometryFrame) cancelAnimationFrame(this.geometryFrame);
      this.geometryFrame = undefined;
      if (this.fitTimer) window.clearTimeout(this.fitTimer);
      this.fitTimer = undefined;
      this.resizeBookmark = undefined;
      this.resizing = false;
      const viewer = this.app?.pdfViewer, frameDoc = this.frame?.contentDocument;
      const page = this.pdfMoved ? viewer?.currentPageNumber : (this.savedPdf?.page ?? viewer?.currentPageNumber);
      for (const attribute of ['data-reading-immersive', 'data-reading-pdf', 'data-reading-touch']) document.documentElement.removeAttribute(attribute);
      frameDoc?.documentElement.removeAttribute('data-reading-immersive');
      frameDoc?.documentElement.removeAttribute('data-reading-touch');
      for (const attribute of ['data-reading-columns', 'data-reading-layout-pending']) frameDoc?.documentElement.removeAttribute(attribute);
      for (const property of ['--reading-columns', '--reading-cell-width', '--reading-slot-height']) frameDoc?.documentElement.style.removeProperty(property);
      if (viewer && this.savedPdf && page) {
        viewer.spreadMode = this.savedPdf.spreadMode;
        viewer.scrollMode = this.savedPdf.scrollMode;
        if (!this.manualZoom) viewer.currentScaleValue = this.savedPdf.scale;
        if (bookmark) this.restorePdfBookmark(bookmark);
        else viewer.scrollPageIntoView({ pageNumber: page });
        viewer.update();
        if (this.savedPdf.sidebar) frameDoc?.getElementById('viewsManagerToggleButton')?.click();
      }
      this.savedPdf = undefined;
      if (this.readingFocus) {
        if (this.readingFocus.tabindex === null) this.readingFocus.element.removeAttribute('tabindex');
        else this.readingFocus.element.setAttribute('tabindex', this.readingFocus.tabindex);
        this.readingFocus = undefined;
      }
      window.scrollTo({ top: this.scrollY, behavior: 'instant' });
      this.button.setAttribute('aria-pressed', 'false');
      this.updateAvailability();
      if (anchor) window.scrollBy({ top: anchor.element.getBoundingClientRect().top - Math.max(anchor.top, this.getBoundingClientRect().bottom + 16), behavior: 'instant' });
      this.button.focus({ preventScroll: true });
    }
    private readingAnchor(top: number) {
      const element = Array.from(document.querySelectorAll<HTMLElement>('.sl-markdown-content :is(h2, h3, p, li, pre)'))
        .find((candidate) => candidate.getBoundingClientRect().height > 0 && candidate.getBoundingClientRect().top >= top);
      return element ? { element, top: element.getBoundingClientRect().top } : undefined;
    }
    disconnectedCallback() {
      this.restore();
      this.controller?.abort();
      this.frameController?.abort();
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      this.pdfResizeObserver?.disconnect();
      document.documentElement.style.removeProperty('--reading-toolbar-height');
    }
  }
  if (!customElements.get('learning-reading-mode')) customElements.define('learning-reading-mode', LearningReadingMode);
</script>
