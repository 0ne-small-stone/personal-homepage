---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { kindLabels, publishedKnowledge } from '../lib/knowledge';
import { sitePath } from '../lib/paths';
import { blogSettings } from '../lib/blog-settings';
const source = Astro.locals.starlightRoute.entry.data.source;
const entries = await publishedKnowledge();
const current = entries.find((entry) => entry.id === Astro.locals.starlightRoute.entry.id);
const readingPaths = entries.map((entry) => sitePath(entry.id));
const externalNotes = entries.flatMap((entry) => entry.data.source?.format === 'link' ? [entry.data.source.url] : []);
---
<DefaultHead />
{current && <meta data-pagefind-filter="类型[content]" content={kindLabels[current.data.kind]} />}
{current && [...new Set(current.data.topics)].map((topic) => <meta data-pagefind-filter="主题[content]" content={topic} />)}
{current?.data.kind === 'article' && blogSettings.tagBrowsingEnabled && (current.data.tags ?? []).map((tag) => <meta data-pagefind-filter="标签[content]" content={tag} />)}
<meta name="lssh-reading-paths" content={JSON.stringify(readingPaths)} />
<meta name="lssh-external-notes" content={JSON.stringify(externalNotes)} />
<meta name="lssh-tag-browsing" content={String(blogSettings.tagBrowsingEnabled)} />
{source?.format === 'link' && <meta http-equiv="refresh" content={`0;url=${source.url}`} />}
<script>
  import '../lib/article-navigation';
</script>
