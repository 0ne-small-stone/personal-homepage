---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import DefaultToc from '@astrojs/starlight/components/TableOfContents.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import Search from './Search.astro';
const { entry, toc } = Astro.locals.starlightRoute;
const reading = Boolean(entry.data.kind && entry.data.source?.format !== 'pdf' && toc);
---
<div class="becoming-workspace-name">
  <span class="becoming-workspace-mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h6a3 3 0 0 1 3 3v12a4 4 0 0 0-4-2H4V5Zm16 0h-4a3 3 0 0 0-3 3v12a4 4 0 0 1 4-2h3V5Z"/></svg></span>
  <div><strong>Becoming</strong><small>资料 · 文章 · 笔记</small></div>
</div>
<div class="becoming-sidebar-search"><Search /></div>
{reading ? <>
  <div class="becoming-sidebar-toc"><DefaultToc /></div>
  <details class="becoming-reading-directory">
    <summary>学习导航</summary>
    <DefaultSidebar />
  </details>
</> : <DefaultSidebar />}
<div class="becoming-theme"><span>阅读外观</span><ThemeSelect /></div>
