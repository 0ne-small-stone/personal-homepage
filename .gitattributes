* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
.node-version text eol=lf
.editorconfig text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.json text eol=lf
public/pdfjs/** -text
*.pdf binary

# Preserve upstream license and vendor formatting verbatim.
docs/**/vendor/** whitespace=-blank-at-eol
public/music/attribution.txt whitespace=-blank-at-eol

# Unified-diff context prefixes are part of the patch, including empty lines/tabs.
patches/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
