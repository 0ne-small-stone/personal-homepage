{
  "name": "personal-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test:search": "node --test tests/search-*.test.mjs",
    "dev": "astro dev",
    "predev": "npm run pdf:prepare",
    "pdf:prepare": "node tools/content/prepare-pdfjs.mjs",
    "check": "node tools/content/cms-related-options.mjs --check && astro check",
    "build": "astro build",
    "preview": "astro preview",
    "music:index": "node tools/music/index-library.mjs --auto-lx",
    "music:watch": "node tools/music/index-library.mjs --auto-lx --watch",
    "music:cloud": "node tools/music/cloud-sync.mjs",
    "music:cloud-watch": "node tools/music/cloud-sync.mjs --watch",
    "music:sync": "node tools/music/cloud-sync.mjs --upload",
    "music:sync-watch": "node tools/music/cloud-sync.mjs --upload --watch",
    "music:connect": "node tools/music/connect-cloud.mjs",
    "music:playlist": "node tools/music/sync-playlist.mjs",
    "music:recommend": "node tools/music/recommendation-service.mjs",
    "music:preview": "node tools/music/preview-service.mjs",
    "music:test": "node --test tools/music/audio-session.test.mjs tools/music/recommendations.test.mjs tools/music/netease-playback.test.mjs tools/music/playback-service.test.mjs tools/music/playback-account.test.mjs tools/music/saved-login.test.mjs tools/music/public-catalog.test.mjs tools/music/album-presentation.test.mjs tools/music/cloud-library.test.mjs tools/music/local-playback.test.mjs tools/music/lx-downloads.test.mjs tools/music/lx-engine.test.mjs tools/music/lx-service.test.mjs tools/music/netease-core.test.mjs tools/music/netease-upload.test.mjs tools/music/netease-route.test.mjs tools/music/netease-snapshot.test.mjs tools/music/music-query.test.mjs tools/music/http.test.mjs tools/music/native-dialog.test.mjs tools/music/query-service.test.mjs tools/music/cassette-foley.test.mjs tools/music/music-api.test.mjs services/music-edge/*.test.mjs",
    "content:import": "node tools/content/import-learning.mjs",
    "materials:prepare": "node tools/content/prepare-local-materials.mjs",
    "cms:sync-related": "node tools/content/cms-related-options.mjs",
    "test:home": "node --test tests/home-*.test.mjs tests/prism-ray.test.mjs",
    "music:publish-catalog": "node tools/music/export-public-catalog.mjs",
    "materials:fetch": "node tools/content/prepare-public-materials.mjs",
    "prebuild": "npm run pdf:prepare && npm run materials:fetch && npm run pdf:fast",
    "music:start": "pwsh -NoProfile -File tools/music/start-preview.ps1",
    "test:links": "node --test tests/website-directory.test.mjs",
    "pdf:fast": "node tools/content/prepare-fast-pdfs.mjs",
    "music:edge": "wrangler dev --config services/music-edge/wrangler.jsonc",
    "music:edge-test": "node --test services/music-edge/*.test.mjs",
    "music:edge-build": "wrangler deploy --dry-run --config services/music-edge/wrangler.jsonc --outdir ../../.local-tools/edge-bundle"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/react": "7.0.1",
    "@astrojs/starlight": "0.42.5",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.3",
    "astro": "7.3.6",
    "gsap": "3.15.0",
    "lenis": "1.3.4",
    "pngjs": "5.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.3",
    "starlight-blog": "0.30.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "body-parser": "2.3.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.0-beta",
    "music-metadata": "12.1.0",
    "patch-package": "8.0.1",
    "send": "1.2.1",
    "typescript": "~5.9.3",
    "wrangler": "4.151.2"
  }
}
